{
  "compliant": false,
  "description": "Every component we ship has a licence we allow.\n\nIt reads two params: allowed_licenses, the licences we allow, and known_package_licenses, the licence of each package whose SBOM doesn't declare one, by package name.",
  "engine": {
    "name": "ergo.rego",
    "version": "0.3.0-dev"
  },
  "ergo": "v0.3",
  "meta": {},
  "requirements": {
    "licences": {
      "causes": [
        {
          "cause": "absent",
          "rows": 1
        }
      ],
      "checks": {
        "$min_subjects": {
          "description": "The in-scope component count is at least 1",
          "expression": "count(matching(components)) >= 1",
          "meta": {}
        },
        "$unique_ids": {
          "description": "Every component id is unique",
          "expression": "count(repeated(ids(components))) == 0",
          "meta": {}
        },
        "$well_formed": {
          "description": "The requirement is written correctly",
          "expression": "count(problems) == 0",
          "meta": {}
        },
        "licence allowed": {
          "$refs": [
            {
              "locations": [
                "$params:/allowed_licenses"
              ],
              "name": "$params.allowed_licenses",
              "value": [
                "BSD-3-Clause",
                "Apache-2.0"
              ]
            }
          ],
          "description": "The licence is allowed",
          "expression": "one of: declared(some licenses.license.id is in $params.allowed_licenses) | known(licenses does not exist and $params.known_package_licenses named by name is in $params.allowed_licenses)",
          "meta": {}
        }
      },
      "description": "",
      "meta": {},
      "require": "every",
      "status": "not_met",
      "subject": "component",
      "subjects": {
        "matching": 3,
        "total": 3
      }
    }
  },
