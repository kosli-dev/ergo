{{ $docs := slice
  (dict "file" "repo/README.md" "name" "README.md" "path" "getting-started" "title" "Getting started" "weight" 1 "ref" "")
  (dict "file" "repo/REFERENCE.md" "name" "REFERENCE.md" "path" "reference" "title" "Reference" "weight" 2 "ref" "")
  (dict "file" "repo/OPA.md" "name" "OPA.md" "path" "opa" "title" "Ergo with OPA" "weight" 3 "ref" "opa" "optional" true)
  (dict "file" "repo/CLI.md" "name" "CLI.md" "path" "cli" "title" "Ergo CLI" "weight" 4 "ref" "cli" "optional" true)
}}
{{ $built := dict }}
{{ range $docs }}
  {{ if resources.Get .file }}{{ $built = merge $built (dict .name true) }}{{ end }}
{{ end }}
{{ range $docs }}
  {{ $doc := . }}
  {{ with resources.Get $doc.file }}
    {{ $md := .Content }}
    {{ $md = replaceRE `^# [^\n]*\n+` "" $md 1 }}
    {{ $md = replaceRE `(?m)^## Getting started\n+` "" $md 1 }}
    {{ range $file := slice "OPA.md" "CLI.md" }}
      {{ if not (index $built $file) }}
        {{ $md = replaceRE (printf `\[([^\]]*)\]\(%s(#[^)]*)?\)` (replace $file "." `\.`)) "${1}" $md }}
      {{ end }}
    {{ end }}
    {{ $md = replaceRE `\(REFERENCE\.md(#[^)]*)?\)` "(../reference/${1})" $md }}
    {{ $md = replaceRE `\(README\.md(#[^)]*)?\)` "(../getting-started/${1})" $md }}
    {{ $md = replaceRE `\(OPA\.md(#[^)]*)?\)` "(../opa/${1})" $md }}
    {{ $md = replaceRE `\(CLI\.md(#[^)]*)?\)` "(../cli/${1})" $md }}
    {{ $md = replace $md "(LICENSE)" (printf "(%s/blob/main/LICENSE)" site.Params.repo) }}
    {{ $.AddPage (dict
      "path" $doc.path
      "title" $doc.title
      "weight" $doc.weight
      "kind" "page"
      "params" (dict "sourceFile" $doc.name "sourceRef" $doc.ref)
      "content" (dict "mediaType" "text/markdown" "value" $md)
    ) }}
  {{ else }}
    {{ if not $doc.optional }}
      {{ errorf "The docs need %s: run site/prepare.sh" $doc.file }}
    {{ end }}
  {{ end }}
{{ end }}
