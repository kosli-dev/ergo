{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ergo.kosli.com/spec/0.2-dev/policy.schema.json",
  "title": "Ergo policy",
  "description": "A policy that passes this schema can still be written wrong in ways a schema can't express, like a sentence that doesn't parse or a from line that names a subject that isn't there. Ergo reports those in $well_formed. A policy that fails this schema still gets a report, which says what's wrong.",
  "type": "object",
  "properties": {
    "ergo_spec": {
      "const": "v0.2-dev",
      "description": "The version of the spec the policy is written for. YAML reads v0.2-dev as text, but 0.2 as a number."
    },
    "subjects": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/$defs/subject"
          },
          {
            "type": "null",
            "description": "A subject with nothing under it reads the input field of its own name."
          }
        ]
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/requirement"
      }
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "meta": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "required": [
    "ergo_spec",
    "subjects",
    "requirements"
  ],
  "$defs": {
    "subject": {
      "type": "object",
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "from": {
          "type": "string",
          "description": "A from line: a path, optionally named by each of a list, optionally whose and conditions. spec/syntax.md says how it's written."
        },
        "identified_by": {
          "type": "string",
          "description": "A path written as in a sentence, like build.number."
        },
        "has": {
          "type": "object",
          "description": "The subject's parts: named paths inside it, so a check can write a short alias where a long path would go. Each key is the alias.",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$",
            "not": {
              "enum": [
                "a",
                "after",
                "an",
                "and",
                "as",
                "at",
                "before",
                "between",
                "count",
                "days",
                "each",
                "empty",
                "equal",
                "every",
                "false",
                "first",
                "hours",
                "in",
                "input",
                "it",
                "item",
                "last",
                "less",
                "minutes",
                "more",
                "named",
                "not",
                "null",
                "of",
                "on",
                "one",
                "or",
                "params",
                "plus",
                "seconds",
                "some",
                "sum",
                "to",
                "true",
                "weeks",
                "whose",
                "within"
              ]
            }
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string",
                "description": "A path inside the subject, written as in a from line, with no whose, count of or named by each of."
              },
              {
                "type": "object",
                "properties": {
                  "from": {
                    "type": "string",
                    "description": "A path inside the subject, written as above."
                  },
                  "identified_by": {
                    "type": "string",
                    "description": "A path inside the part, to the value that identifies it. Nothing reads it yet."
                  }
                },
                "required": [
                  "from"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "requirement": {
      "type": "object",
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "meta": {
          "type": [
            "object",
            "null"
          ]
        },
        "subject": {
          "type": "string",
          "pattern": "\\S",
          "description": "The name of an entry in subjects."
        },
        "require": {
          "enum": [
            "every",
            "some"
          ]
        },
        "min_subjects": {
          "type": "integer",
          "minimum": 0
        },
        "checks": {
          "$ref": "#/$defs/requirement_checks",
          "minProperties": 1
        }
      },
      "required": [
        "subject",
        "checks"
      ],
      "additionalProperties": false
    },
    "requirement_checks": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/sentence_check"
      }
    },
    "sentence_check": {
      "description": "A check written as a sentence, alone, under assert, or as the options of an any_of. spec/syntax.md and spec/sentences.abnf say how a sentence is written.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "assert": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                }
              ]
            },
            "for": {
              "type": "string",
              "description": "A for line: one or two items, each every or some, a path, an optional whose and as a name."
            },
            "description": {
              "type": [
                "string",
                "null"
              ]
            },
            "meta": {
              "type": [
                "object",
                "null"
              ]
            }
          },
          "required": [
            "assert"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "any_of": {
              "type": "object",
              "description": "Named options. The check passes when every sentence of one option passes.",
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1
                  }
                ]
              },
              "minProperties": 1
            },
            "description": {
              "type": [
                "string",
                "null"
              ]
            },
            "meta": {
              "type": [
                "object",
                "null"
              ]
            }
          },
          "required": [
            "any_of"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
