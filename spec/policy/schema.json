{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ergo policy",
  "description": "A policy that passes this schema can still be written wrong in ways a schema can't express, like a min above max, a step after a naming step or nesting deeper than one level. Ergo reports those in $well_formed. A policy that fails this schema still gets a report, which says what's wrong.",
  "type": "object",
  "properties": {
    "subjects": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/$defs/subject"
          },
          {
            "type": "null",
            "description": "A subject with nothing under it reads the input field of its own name."
          }
        ]
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/requirement"
      }
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "meta": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "required": [
    "subjects",
    "requirements"
  ],
  "$defs": {
    "subject": {
      "type": "object",
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "from": {
          "anyOf": [
            {
              "type": "array",
              "description": "A naming step can only be the last step.",
              "items": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/key"
                  },
                  {
                    "$ref": "#/$defs/ref"
                  },
                  {
                    "$ref": "#/$defs/naming_step"
                  }
                ]
              }
            },
            {
              "type": "string",
              "description": "A from line: a path, optionally named by each of a list, optionally whose and conditions. spec/sentences.md says how it's written."
            }
          ]
        },
        "identified_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/path"
            },
            {
              "type": "string",
              "description": "A path written as in a sentence, like build.number."
            }
          ]
        },
        "applies_to": {
          "$ref": "#/$defs/named_checks"
        },
        "of": {
          "type": "string",
          "description": "The name of another subject this one builds on. A subject with of has no from or identified_by of its own."
        },
        "has": {
          "type": "object",
          "description": "The subject's parts: named paths inside it, so a check can write a short alias where a long path would go. Each key is the alias.",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$",
            "not": {
              "enum": [
                "a",
                "after",
                "an",
                "and",
                "as",
                "at",
                "before",
                "between",
                "count",
                "days",
                "each",
                "empty",
                "equal",
                "every",
                "false",
                "first",
                "hours",
                "in",
                "input",
                "item",
                "last",
                "less",
                "minutes",
                "more",
                "named",
                "not",
                "null",
                "of",
                "on",
                "one",
                "or",
                "params",
                "plus",
                "seconds",
                "some",
                "sum",
                "to",
                "true",
                "weeks",
                "whose",
                "within"
              ]
            }
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string",
                "description": "A path inside the subject, written as in a from line, with no whose, count of or named by each of."
              },
              {
                "type": "object",
                "properties": {
                  "from": {
                    "type": "string",
                    "description": "A path inside the subject, written as above."
                  },
                  "identified_by": {
                    "type": "string",
                    "description": "A path inside the part, to the value that identifies it. Nothing reads it yet."
                  }
                },
                "required": [
                  "from"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "requirement": {
      "type": "object",
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "meta": {
          "type": [
            "object",
            "null"
          ]
        },
        "subject": {
          "type": "string",
          "pattern": "\\S",
          "description": "The name of an entry in subjects."
        },
        "require": {
          "enum": [
            "every",
            "some"
          ]
        },
        "min_subjects": {
          "type": "integer",
          "minimum": 0
        },
        "checks": {
          "$ref": "#/$defs/requirement_checks",
          "minProperties": 1
        }
      },
      "required": [
        "subject",
        "checks"
      ],
      "additionalProperties": false
    },
    "named_checks": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/check"
      }
    },
    "requirement_checks": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/$defs/check"
          },
          {
            "$ref": "#/$defs/sentence_check"
          }
        ]
      }
    },
    "sentence_check": {
      "description": "A check written as a sentence, alone or under assert. spec/sentences.md and spec/sentences.abnf say how a sentence is written.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "assert": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                }
              ]
            },
            "for": {
              "type": "string",
              "description": "A for line: one or two items, each every or some, a path, an optional whose and as a name."
            },
            "description": {
              "type": [
                "string",
                "null"
              ]
            },
            "meta": {
              "type": [
                "object",
                "null"
              ]
            }
          },
          "required": [
            "assert"
          ],
          "additionalProperties": false
        }
      ]
    },
    "key": {
      "description": "A key of an object, or an index of a list. An index has to be written as digits alone, so 1.0 can't be one, although JSON Schema reads it as an integer.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ]
    },
    "ref": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "array",
          "prefixItems": [
            {
              "enum": [
                "$$params",
                "$$input"
              ]
            }
          ],
          "items": {
            "$ref": "#/$defs/key"
          },
          "minItems": 1
        }
      },
      "required": [
        "ref"
      ],
      "additionalProperties": false
    },
    "literal": {
      "type": "object",
      "properties": {
        "literal": true
      },
      "required": [
        "literal"
      ],
      "additionalProperties": false
    },
    "name": {
      "type": "string",
      "pattern": "^[^$]"
    },
    "naming_step": {
      "type": "object",
      "properties": {
        "each_as": {
          "$ref": "#/$defs/name"
        },
        "keys": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/key"
                  },
                  {
                    "$ref": "#/$defs/ref"
                  },
                  {
                    "$ref": "#/$defs/literal"
                  }
                ]
              }
            },
            {
              "$ref": "#/$defs/ref"
            },
            {
              "$ref": "#/$defs/literal"
            }
          ]
        }
      },
      "required": [
        "each_as"
      ],
      "additionalProperties": false
    },
    "selector": {
      "type": "object",
      "properties": {
        "where": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/value"
          },
          "description": "An empty where matches nothing."
        }
      },
      "required": [
        "where"
      ],
      "additionalProperties": false
    },
    "path": {
      "type": "array",
      "description": "Its first step can be $$input, $$params or $name. It can hold one selector at most.",
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/key"
          },
          {
            "$ref": "#/$defs/selector"
          },
          {
            "$ref": "#/$defs/ref"
          },
          {
            "type": "object",
            "properties": {
              "literal": {
                "type": "string"
              }
            },
            "required": [
              "literal"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "value": {
      "description": "Any JSON value. An object with a single ref or literal key is read as a ref or a literal.",
      "anyOf": [
        {
          "$ref": "#/$defs/ref"
        },
        {
          "$ref": "#/$defs/literal"
        },
        true
      ]
    },
    "values": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        {
          "$ref": "#/$defs/ref"
        },
        {
          "$ref": "#/$defs/literal"
        }
      ]
    },
    "number": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "$ref": "#/$defs/ref"
        },
        {
          "$ref": "#/$defs/literal"
        }
      ]
    },
    "common": {
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "meta": {
          "type": [
            "object",
            "null"
          ]
        },
        "expression": {
          "description": "Used in place of the rendered expression when it's a string, and ignored otherwise."
        },
        "inputs": {
          "type": "array"
        },
        "substitute": {
          "$ref": "#/$defs/check"
        }
      }
    },
    "builtin_ops": {
      "enum": [
        "equals",
        "in",
        "present",
        "missing",
        "non_empty_string",
        "empty",
        "matches_any",
        "not_matches_any",
        "range",
        "includes",
        "excludes",
        "compare",
        "compare_time",
        "all",
        "any",
        "any_of"
      ]
    },
    "check": {
      "description": "A check in checks or applies_to. It can have a substitute, and its op can be a custom operator.",
      "anyOf": [
        {
          "$ref": "#/$defs/builtin_check"
        },
        {
          "description": "A custom operator. It can have any fields, and its op must be declared to Ergo.",
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "not": {
                "$ref": "#/$defs/builtin_ops"
              }
            }
          },
          "required": [
            "op"
          ]
        }
      ]
    },
    "builtin_check": {
      "type": "object",
      "required": [
        "op"
      ],
      "allOf": [
        {
          "$ref": "#/$defs/common"
        }
      ],
      "oneOf": [
        {
          "properties": {
            "op": {
              "const": "equals"
            },
            "path": {
              "$ref": "#/$defs/path"
            },
            "value": {
              "$ref": "#/$defs/value"
            }
          },
          "required": [
            "path",
            "value"
          ]
        },
        {
          "properties": {
            "op": {
              "const": "in"
            },
            "path": {
              "$ref": "#/$defs/path"
            },
            "values": {
              "$ref": "#/$defs/values"
            }
          },
          "required": [
            "path",
            "values"
          ]
        },
        {
          "properties": {
            "op": {
              "enum": [
                "present",
                "missing",
                "non_empty_string",
                "empty"
              ]
            },
            "path": {
              "$ref": "#/$defs/path"
            }
          },
          "required": [
            "path"
          ]
        },
        {
          "properties": {
            "op": {
              "enum": [
                "matches_any",
                "not_matches_any"
              ]
            },
            "path": {
              "$ref": "#/$defs/path"
            },
            "patterns": {
              "$ref": "#/$defs/patterns"
            }
          },
          "required": [
            "path",
            "patterns"
          ]
        },
        {
          "properties": {
            "op": {
              "const": "range"
            },
            "path": {
              "$ref": "#/$defs/path"
            },
            "min": {
              "$ref": "#/$defs/number"
            },
            "max": {
              "$ref": "#/$defs/number"
            }
          },
          "required": [
            "path",
            "min",
            "max"
          ]
        },
        {
          "properties": {
            "op": {
              "enum": [
                "includes",
                "excludes"
              ]
            },
            "path": {
              "$ref": "#/$defs/path"
            },
            "value": {
              "$ref": "#/$defs/value"
            }
          },
          "required": [
            "path",
            "value"
          ]
        },
        {
          "properties": {
            "op": {
              "enum": [
                "includes",
                "excludes"
              ]
            },
            "path": {
              "$ref": "#/$defs/path"
            },
            "values": {
              "anyOf": [
                {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/value"
                  }
                },
                {
                  "$ref": "#/$defs/ref"
                },
                {
                  "$ref": "#/$defs/literal"
                }
              ]
            }
          },
          "required": [
            "path",
            "values"
          ]
        },
        {
          "properties": {
            "op": {
              "const": "compare"
            },
            "left": {
              "$ref": "#/$defs/compare_side"
            },
            "right": {
              "$ref": "#/$defs/compare_side"
            },
            "cmp": {
              "enum": [
                "eq",
                "ne",
                "gt",
                "gte",
                "lt",
                "lte"
              ]
            },
            "within": {
              "type": "number"
            }
          },
          "required": [
            "left",
            "right",
            "cmp"
          ]
        },
        {
          "properties": {
            "op": {
              "const": "compare_time"
            },
            "left": {
              "$ref": "#/$defs/path"
            },
            "right": {
              "$ref": "#/$defs/path"
            },
            "cmp": {
              "enum": [
                "eq",
                "ne",
                "gt",
                "gte",
                "lt",
                "lte"
              ]
            }
          },
          "required": [
            "left",
            "right",
            "cmp"
          ]
        },
        {
          "properties": {
            "op": {
              "enum": [
                "all",
                "any"
              ]
            },
            "path": {
              "$ref": "#/$defs/path"
            },
            "each": {
              "$ref": "#/$defs/path"
            },
            "as": {
              "$ref": "#/$defs/name"
            },
            "check": {
              "$ref": "#/$defs/inner_check"
            }
          },
          "required": [
            "path",
            "check"
          ]
        },
        {
          "properties": {
            "op": {
              "const": "any_of"
            },
            "options": {
              "anyOf": [
                {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {
                    "$ref": "#/$defs/option"
                  }
                },
                {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/option"
                  }
                }
              ]
            }
          },
          "required": [
            "options"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "inner_check": {
      "description": "The check inside all or any. It can't be a custom operator, and a substitute on it is ignored.",
      "$ref": "#/$defs/builtin_check"
    },
    "option": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/builtin_check",
        "properties": {
          "op": {
            "not": {
              "const": "any_of"
            }
          }
        }
      }
    },
    "patterns": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/ref"
              },
              {
                "$ref": "#/$defs/literal"
              }
            ]
          }
        },
        {
          "$ref": "#/$defs/ref"
        },
        {
          "$ref": "#/$defs/literal"
        }
      ]
    },
    "compare_side": {
      "description": "A side of compare: a path, a literal, or a value worked out from the subject. See REFERENCE.md, Derived values.",
      "anyOf": [
        {
          "$ref": "#/$defs/path"
        },
        {
          "$ref": "#/$defs/literal"
        },
        {
          "$ref": "#/$defs/count"
        },
        {
          "$ref": "#/$defs/sum"
        },
        {
          "$ref": "#/$defs/add"
        }
      ]
    },
    "count": {
      "type": "object",
      "properties": {
        "count": {
          "$ref": "#/$defs/path"
        },
        "where": {
          "$ref": "#/$defs/builtin_check"
        }
      },
      "required": [
        "count"
      ],
      "additionalProperties": false
    },
    "sum": {
      "type": "object",
      "properties": {
        "sum": {
          "$ref": "#/$defs/path"
        },
        "each": {
          "$ref": "#/$defs/path"
        },
        "where": {
          "$ref": "#/$defs/builtin_check"
        }
      },
      "required": [
        "sum",
        "each"
      ],
      "additionalProperties": false
    },
    "add": {
      "type": "object",
      "properties": {
        "add": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/path"
              },
              {
                "$ref": "#/$defs/literal"
              },
              {
                "$ref": "#/$defs/count"
              },
              {
                "$ref": "#/$defs/sum"
              }
            ]
          }
        }
      },
      "required": [
        "add"
      ],
      "additionalProperties": false
    }
  }
}
