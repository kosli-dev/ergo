; The grammar of checks written as sentences, in ABNF (RFC 5234).
; syntax.md says what each form means and what it can't say here.
; Every quoted string is case-sensitive, as if written with RFC 7405's %s.
; WS between two words is one space when the report prints a sentence.
; Whitespace at either end of a line is dropped before it's read: every
; character with Unicode's White_Space property, as syntax.md's
; [sentence.ends] lists them, and so is the whitespace around the path of an
; identified_by or a part. Inside a line, WS is spaces only.

; A check is one assertion, or several joined with "and". Under assert:,
; a YAML list holds one assertion per item and means the same.
check             = assertion *(WS "and" WS assertion)

assertion         = plain / quantified / derived-assertion / elapsed-assertion
plain             = (it-path / path) WS phrase
quantified        = quantifier WS (it-path / path) [WS whose] [if-any] WS phrase
quantifier        = "every" / "some"
if-any            = "," WS "if" WS "any,"
derived-assertion = derived-left WS compare-phrase
elapsed-assertion = elapsed WS compare-phrase

; A for: line walks one or two lists and gives each item an alias, or
; picks one item of a list by its position.
for-line          = for-item ["," WS for-item]
for-item          = quantifier WS path [WS whose] [if-any] WS "as" WS alias
                  / position WS "of" WS plain-path [WS whose] [WS sorted-by] WS "as" WS alias
sorted-by         = "sorted" WS "by" WS first-key *step [WS "alphabetically"]
alias             = bare-key

; A subject's from: line.
from-line         = ["every" WS] path [WS "named" WS "by" WS "each" WS "of" WS right-path] [WS from-whose]

; whose keeps the items that pass every condition.
whose             = "whose" WS condition *(WS "and" WS condition)
condition         = (it-path / path) WS phrase / (derived / elapsed) WS compare-phrase
; A from line's whose also takes a one-line some or every, with no whose of its own.
from-condition    = condition / quantifier WS (it-path / path) [if-any] WS phrase
from-whose        = "whose" WS from-condition *(WS "and" WS from-condition)

; Derived values: count of, sum of, and terms added with plus.
; Only the last term on the left can carry a whose, and none on the right.
derived           = ("count" / "sum") WS "of" WS (it-path / path)
; ergo.rego doesn't run an elapsed time in a whose or after a plus yet.
elapsed           = ("seconds" / "minutes" / "hours" / "days" / "weeks") WS "elapsed" WS "from" WS path WS "to" WS path
term              = right-path / derived / elapsed / number
derived-left      = derived [WS whose]
                  / 1*(term WS "plus" WS) (term / derived WS whose)
field             = (right-path / derived / elapsed) *(WS "plus" WS term)
                  / number 1*(WS "plus" WS term)
operand           = value / field

; Phrases. compare-phrase is the subset a derived value can take.
phrase            = one-of-phrase / exists-phrase / empty-phrase / type-phrase
                  / contains-phrase / contains-all-phrase / matches-phrase
                  / starts-phrase / alphabetical-phrase / time-phrase / compare-phrase
compare-phrase    = within-phrase / order-phrase / between-phrase / is-phrase

is-phrase         = ("is" WS "not" / "does" WS "not" WS "equal") WS operand
                  / ("is" WS "equal" WS "to" / "equals" / "is") WS operand
within-phrase     = ("is" WS "equal" WS "to" / "equals" / "is" / "is" WS "not" / "does" WS "not" WS "equal") WS operand WS "within" WS number
order-phrase      = ("is" WS "at" WS "least" / "is" WS "at" WS "most" / "is" WS "more" WS "than" / "is" WS "less" WS "than") WS operand
between-phrase    = "is" WS ["not" WS] "between" WS number WS "and" WS number
one-of-phrase     = ("is" WS "one" WS "of" / "is" WS "in") WS list
                  / ("is" WS "not" WS "one" WS "of" / "is" WS "not" WS "in") WS list
exists-phrase     = "exists" / "does" WS "not" WS "exist"
empty-phrase      = "is" WS "empty" / "is" WS "not" WS "empty"
type-phrase       = "is" WS ["not" WS] "a" WS "non-empty" WS "string" / "is" WS ["not" WS] ("a" / "an") WS type
type              = "list" / "string" / "number" / "boolean" / "object"
contains-phrase   = ("contains" / "does" WS "not" WS "contain") WS operand
contains-all-phrase = ("contains" WS "all" WS "of" / "contains" WS "none" WS "of" / "contains" WS "some" WS "of" / "does" WS "not" WS "contain" WS "all" WS "of") WS list
matches-phrase    = ("matches" / "does" WS "not" WS "match") WS list
starts-phrase     = ("starts" WS "with" / "ends" WS "with" / "does" WS "not" WS "start" WS "with" / "does" WS "not" WS "end" WS "with") WS operand
alphabetical-phrase = "is" WS "alphabetically" WS ("before" / "after" / "on" WS "or" WS "before" / "on" WS "or" WS "after") WS operand
time-phrase       = ("is" WS "before" / "is" WS "after" / "is" WS "on" WS "or" WS "after" / "is" WS "on" WS "or" WS "before") WS operand

list              = values / right-path
values            = value *("," [WS] value)
value             = string / number / "true" / "false" / "null"

; Paths. The first key of a path, when bare, is never a word of the
; grammar (syntax.md lists them); "." in front of it lifts that.
; On the right side of a phrase a quoted string is a value, so a path
; there can't start with a quoted key unless a "." is in front of it.
; "it" is the subject itself, never a bare first key. The grammar lets it
; stand where an assertion or a whose condition starts and after every,
; some, count of and sum of, with a position in front if a field's path
; can have one there. syntax.md says which of those places a check
; can use, and writes the others wrong.
; A position picks one item of the list a path ends at, counting from 1:
; item 3 of items, item 2 from last of items, first of items, last of
; items. items[2] is the same item as item 3 of items.
it                = "it"
it-path           = it / position WS "of" WS it
path              = plain-path / position WS "of" WS plain-path
plain-path        = start *step
right-path        = plain-right / position WS "of" WS plain-right
plain-right       = (dollar-name / bare-key / "." key) *step
position          = "item" WS positive [WS "from" WS "last"] / "first" / "last"
positive          = %x31-39 *DIGIT
start             = dollar-name / first-key
first-key         = bare-key / "." key / quoted-key
step              = "." key / WS "named" WS "by" WS reference
                  / "[" reference "]" / "[" quoted-key "]" / "[" int "]"
key               = bare-key / quoted-key
reference         = dollar-name "." key / other-name / alias
dollar-name       = "$" (ALPHA / "_") *name-char
name-char         = ALPHA / DIGIT / "_"
other-name        = "$" ( (%x41-5A / %x5F / %x61-68 / %x6A-6F / %x71-7A) *name-char
                        / %x70 [ not-a *name-char / %x61 [ not-r *name-char / %x72 [ not-a2 *name-char
                          / %x61 [ not-m *name-char / %x6D [ not-s *name-char / %x73 1*name-char ] ] ] ] ]
                        / %x69 [ not-n *name-char / %x6E [ not-p *name-char / %x70 [ not-u *name-char
                          / %x75 [ not-t *name-char / %x74 1*name-char ] ] ] ] )
not-a             = DIGIT / "_" / %x41-5A / %x62-7A
not-r             = DIGIT / "_" / %x41-5A / %x61-71 / %x73-7A
not-a2            = DIGIT / "_" / %x41-5A / %x62-7A
not-m             = DIGIT / "_" / %x41-5A / %x61-6C / %x6E-7A
not-s             = DIGIT / "_" / %x41-5A / %x61-72 / %x74-7A
not-n             = DIGIT / "_" / %x41-5A / %x61-6D / %x6F-7A
not-p             = DIGIT / "_" / %x41-5A / %x61-6F / %x71-7A
not-u             = DIGIT / "_" / %x41-5A / %x61-74 / %x76-7A
not-t             = DIGIT / "_" / %x41-5A / %x61-73 / %x75-7A
bare-key          = (ALPHA / "_") *(ALPHA / DIGIT / "_" / "-")
quoted-key        = dq-string

; Values are written as JSON writes a scalar. A single-quoted string keeps
; backslashes as written, except before a quote or another backslash.
string            = dq-string / sq-string
dq-string         = DQUOTE *dq-char DQUOTE
dq-char           = %x20-21 / %x23-5B / %x5D-10FFFF / "\" dq-escape
dq-escape         = DQUOTE / "\" / "/" / "b" / "f" / "n" / "r" / "t" / "u" 4HEXDIG
sq-string         = "'" *sq-char "'"
sq-char           = %x20-26 / %x28-5B / %x5D-10FFFF / "\" %x20-10FFFF
number            = ["-"] int [frac] [exp]
int               = "0" / (%x31-39 *DIGIT)
frac              = "." 1*DIGIT
exp               = ("e" / "E") ["+" / "-"] 1*DIGIT

; ALPHA, DIGIT, HEXDIG, SP and DQUOTE are the core rules of RFC 5234 appendix B.
WS                = 1*SP
