{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ergo report",
  "type": "object",
  "properties": {
    "compliant": {"type": "boolean", "description": "true when there's at least one requirement and none is not_met"},
    "description": {"type": "string"},
    "meta": {"type": "object"},
    "requirements": {"type": "object", "additionalProperties": {"$ref": "#/$defs/requirement"}},
    "results": {"type": "array", "items": {"$ref": "#/$defs/row"}},
    "subjects": {
      "type": "object",
      "description": "The subjects the requirements use, directly or through the subjects they narrow or read from, by name.",
      "additionalProperties": {"$ref": "#/$defs/subject"}
    }
  },
  "required": ["compliant", "description", "meta", "requirements", "results", "subjects"],
  "additionalProperties": false,
  "$defs": {
    "cause": {"enum": ["satisfied", "substituted", "ill_formed", "not_an_object", "ambiguous", "unmatched", "unusable", "absent", "null", "value"]},
    "subject": {
      "type": "object",
      "properties": {
        "description": {"type": "string", "description": "The subject's description, or \"\" when it has none."},
        "from": {"type": "string", "description": "How the subject is found, as a from line is written, or <invalid from> when it is written wrong."},
        "identified_by": {"type": ["string", "null"], "description": "The path of the subject's id, or null when it has none and the whole subject is its id."},
        "parts": {
          "type": "object",
          "description": "Every part the subject has, including the ones it keeps from a subject it narrows, by alias.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "from": {"type": "string", "description": "The part's path, written as a sentence writes it, or <invalid from> when it is written wrong."},
              "identified_by": {"type": ["string", "null"], "description": "The path of the part's id, <invalid identified_by> when it is written wrong, or null when it has none."}
            },
            "required": ["from", "identified_by"],
            "additionalProperties": false
          }
        }
      },
      "required": ["description", "from", "identified_by", "parts"],
      "additionalProperties": false
    },
    "requirement": {
      "type": "object",
      "properties": {
        "causes": {
          "type": "array",
          "description": "The causes of the rows that would be violations of the requirement, worst first, each with how many rows have it. Empty when the requirement is met or not_applicable.",
          "items": {
            "type": "object",
            "properties": {
              "cause": {"$ref": "#/$defs/cause"},
              "rows": {"type": "integer", "minimum": 1}
            },
            "required": ["cause", "rows"],
            "additionalProperties": false
          }
        },
        "checks": {
          "type": "object",
          "description": "Each check as written, plus the checks ergo adds, which start with $.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "description": {"type": "string"},
              "expression": {"type": "string"},
              "meta": {"type": "object"},
              "$refs": {"type": "array", "items": {"$ref": "#/$defs/input"}}
            },
            "required": ["description", "expression", "meta"]
          }
        },
        "description": {"type": "string"},
        "meta": {"type": "object"},
        "require": {"description": "The require the requirement was written with, or every by default."},
        "status": {"enum": ["met", "not_met", "not_applicable"]},
        "subject": {"type": ["string", "null"], "description": "The name of the subject the requirement checks, or null when it names none or one that isn't in the policy's subjects."},
        "subjects": {
          "type": "object",
          "properties": {
            "matching": {"type": "integer", "minimum": 0},
            "total": {"type": "integer", "minimum": 0}
          },
          "required": ["matching", "total"],
          "additionalProperties": false
        }
      },
      "required": ["causes", "checks", "description", "meta", "require", "status", "subject", "subjects"],
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "properties": {"name": {"type": "string"}, "value": true},
      "required": ["name", "value"],
      "additionalProperties": false
    },
    "row": {
      "type": "object",
      "properties": {
        "requirement": {"type": "string"},
        "subject": {
          "type": "object",
          "properties": {
            "type": {"description": "The name of the requirement's subject."},
            "id": {"description": "The subject's id, or null for the rows of the checks ergo adds to a requirement."},
            "in": {"type": "object", "description": "Only for a subject read from another subject: the parent subject's name and its id.", "maxProperties": 1}
          },
          "required": ["type", "id"],
          "additionalProperties": false
        },
        "check": {"type": "string"},
        "inputs": {"type": "array", "items": {"$ref": "#/$defs/input"}},
        "passed": {"type": "boolean"},
        "cause": {"$ref": "#/$defs/cause"},
        "failed_items": {
          "type": "array",
          "description": "Only on rows of all, any, every, some and for checks.",
          "items": {
            "type": "object",
            "properties": {"path": {"type": "string"}, "item": {"type": "string", "description": "The path of the list item the entry belongs to. For all and any, the same as path."}, "cause": {"$ref": "#/$defs/cause"}, "value": true, "failed_assertions": {"$ref": "#/$defs/failed_assertions", "description": "Only on entries of for checks: the sentences that failed for that item, in the order written."}},
            "required": ["path", "item", "cause", "value"],
            "additionalProperties": false
          }
        },
        "failed_assertions": {"$ref": "#/$defs/failed_assertions", "description": "Only on rows of checks written as several sentences without a for line: the ones that failed, in the order written."}
      },
      "required": ["requirement", "subject", "check", "inputs", "passed", "cause"],
      "additionalProperties": false,
      "if": {"properties": {"passed": {"const": true}}},
      "then": {"properties": {"cause": {"enum": ["satisfied", "substituted"]}}},
      "else": {"properties": {"cause": {"not": {"enum": ["satisfied", "substituted"]}}}}
    },
    "failed_assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {"assertion": {"type": "string"}, "cause": {"$ref": "#/$defs/cause"}},
        "required": ["assertion", "cause"],
        "additionalProperties": false
      }
    }
  }
}
