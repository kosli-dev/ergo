          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": true, "cause": "satisfied", "inputs": [{"name": "x", "value": "a", "locations": ["/things/0/x"]}]}
        ],
        "expressions": {"s": {"c": "x is a non-empty string"}}
      },
      {
        "description": "passes on a string of spaces",
        "rules": ["non_empty_string.pass"],
        "input": {"things": [{"id": "t1", "x": " "}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": true, "cause": "satisfied", "inputs": [{"name": "x", "value": " ", "locations": ["/things/0/x"]}]}
        ]
      },
      {
        "description": "fails as value on an empty string",
        "rules": ["non_empty_string.fail"],
        "input": {"things": [{"id": "t1", "x": ""}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": false, "cause": "value", "inputs": [{"name": "x", "value": "", "locations": ["/things/0/x"]}]}
        ]
      },
      {
        "description": "fails as value on a number, because checking the type is its job",
        "rules": ["non_empty_string.fail"],
        "input": {"things": [{"id": "t1", "x": 1}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": false, "cause": "value", "inputs": [{"name": "x", "value": 1, "locations": ["/things/0/x"]}]}
        ]
      },
      {
        "description": "fails as absent when the field is missing",
        "rules": ["non_empty_string.fail", "path.absent"],
        "input": {"things": [{"id": "t1"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": false, "cause": "absent", "inputs": [{"name": "x", "value": null, "locations": ["/things/0"]}]}
        ]
      },
      {
        "description": "fails as null when the field is null",
        "rules": ["non_empty_string.fail", "path.null"],
