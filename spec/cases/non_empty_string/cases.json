        "input": {"things": [{"id": "t1", "x": "a"}]},
        "results": [
          {
            "cause": "satisfied",
            "check": "c",
            "inputs": [
              {
                "locations": [
                  "/things/0/x"
                ],
                "name": "x",
                "value": "a"
              }
            ],
            "passed": true,
            "requirement": "s",
            "subject": {
              "id": "t1",
              "type": "thing"
            }
          }
        ],
        "expressions": {"s": {"c": "x is a non-empty string"}}
      },
      {
