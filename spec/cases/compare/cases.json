[
  {
    "description": "compare with eq",
    "policy": {"ergo_spec": "v0.1", "subjects": {"thing": {"from": "things", "identified_by": "id"}}, "requirements": {"s": {"subject": "thing", "checks": {"c": ".a equals b"}}}},
    "cases": [
      {
        "description": "passes on 1 and 1.0",
        "rules": ["compare.pass", "value.equal", "sentence.print.canonical"],
        "input": {"things": [{"a": 1, "b": 1.0, "id": "t1"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": true, "cause": "satisfied", "inputs": [{"name": ".a", "value": 1}, {"name": "b", "value": 1}]}
        ],
        "expressions": {"s": {"c": ".a equals b"}}
      },
      {
        "description": "passes on equal objects",
        "rules": ["compare.pass", "value.equal"],
        "input": {"things": [{"a": {"n": 1}, "b": {"n": 1.0}, "id": "t1"}]},
        "results": [
          {
            "requirement": "s",
            "subject": {"type": "thing", "id": "t1"},
            "check": "c",
            "passed": true,
            "cause": "satisfied",
            "inputs": [{"name": ".a", "value": {"n": 1}}, {"name": "b", "value": {"n": 1}}]
          }
        ]
      },
      {
        "description": "fails as unusable when the types differ",
        "rules": ["compare.fail"],
        "input": {"things": [{"a": "1", "b": 1, "id": "t1"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": false, "cause": "unusable", "inputs": [{"name": ".a", "value": "1"}, {"name": "b", "value": 1}]}
        ]
      },
      {
        "description": "fails as null when both are null",
        "rules": ["compare.fail"],
        "input": {"things": [{"a": null, "b": null, "id": "t1"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": false, "cause": "null", "inputs": [{"name": ".a", "value": null}, {"name": "b", "value": null}]}
        ]
      },
      {
        "description": "fails as absent when one is missing and the other null",
        "rules": ["compare.fail"],
        "input": {"things": [{"b": null, "id": "t1"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": false, "cause": "absent", "inputs": [{"name": ".a", "value": null}, {"name": "b", "value": null}]}
        ]
      }
    ]
  },
  {
    "description": "compare with ne",
    "policy": {"ergo_spec": "v0.1", "subjects": {"thing": {"from": "things", "identified_by": "id"}}, "requirements": {"s": {"subject": "thing", "checks": {"c": ".a does not equal b"}}}},
    "cases": [
      {
        "description": "passes on two different strings",
        "rules": ["compare.pass"],
        "input": {"things": [{"a": "x", "b": "y", "id": "t1"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": true, "cause": "satisfied", "inputs": [{"name": ".a", "value": "x"}, {"name": "b", "value": "y"}]}
        ]
      },
      {
        "description": "fails as unusable when the types differ, though they aren't equal",
        "rules": ["compare.fail"],
        "input": {"things": [{"a": "1", "b": 1, "id": "t1"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": false, "cause": "unusable", "inputs": [{"name": ".a", "value": "1"}, {"name": "b", "value": 1}]}
        ]
      },
      {
        "description": "fails as absent when both are missing",
        "rules": ["compare.fail"],
        "input": {"things": [{"id": "t1"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": false, "cause": "absent", "inputs": [{"name": ".a", "value": null}, {"name": "b", "value": null}]}
        ]
      }
    ]
  },
  {
    "description": "compare with lt",
    "policy": {"ergo_spec": "v0.1", "subjects": {"thing": {"from": "things", "identified_by": "id"}}, "requirements": {"s": {"subject": "thing", "checks": {"c": ".a is less than b"}}}},
    "cases": [
      {
        "description": "passes on two numbers in order",
        "rules": ["compare.pass", "sentence.print.canonical"],
        "input": {"things": [{"a": 1, "b": 2, "id": "t1"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": true, "cause": "satisfied", "inputs": [{"name": ".a", "value": 1}, {"name": "b", "value": 2}]}
        ],
        "expressions": {"s": {"c": ".a is less than b"}}
      },
      {
        "description": "fails as value on two numbers out of order",
        "rules": ["compare.fail"],
        "input": {"things": [{"a": 2, "b": 1, "id": "t1"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": false, "cause": "value", "inputs": [{"name": ".a", "value": 2}, {"name": "b", "value": 1}]}
        ]
      },
      {
        "description": "fails as unusable on two strings, so numbers held as strings aren't ordered as text",
        "rules": ["compare.pass", "compare.fail"],
        "input": {"things": [{"a": "80", "b": "9", "id": "t1"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": false, "cause": "unusable", "inputs": [{"name": ".a", "value": "80"}, {"name": "b", "value": "9"}]}
        ]
      },
      {
        "description": "fails as unusable on booleans",
        "rules": ["compare.fail"],
        "input": {"things": [{"a": false, "b": true, "id": "t1"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": false, "cause": "unusable", "inputs": [{"name": ".a", "value": false}, {"name": "b", "value": true}]}
        ]
      },
      {
        "description": "fails as unusable on objects",
        "rules": ["compare.fail"],
        "input": {"things": [{"a": {"n": 1}, "b": {"o": 1}, "id": "t1"}]},
        "results": [
          {
            "requirement": "s",
            "subject": {"type": "thing", "id": "t1"},
            "check": "c",
            "passed": false,
            "cause": "unusable",
            "inputs": [{"name": ".a", "value": {"n": 1}}, {"name": "b", "value": {"o": 1}}]
          }
        ]
      },
      {
        "description": "fails as absent when one is missing",
        "rules": ["compare.fail"],
        "input": {"things": [{"b": 5, "id": "t1"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": false, "cause": "absent", "inputs": [{"name": ".a", "value": null}, {"name": "b", "value": 5}]}
        ]
      }
    ]
  },
  {
    "description": "compare with gte",
    "policy": {"ergo_spec": "v0.1", "subjects": {"thing": {"from": "things", "identified_by": "id"}}, "requirements": {"s": {"subject": "thing", "checks": {"c": ".a is at least b"}}}},
    "cases": [
      {
        "description": "passes on 2 and 2.0",
        "rules": ["compare.pass", "value.equal"],
        "input": {"things": [{"a": 2, "b": 2.0, "id": "t1"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": true, "cause": "satisfied", "inputs": [{"name": ".a", "value": 2}, {"name": "b", "value": 2}]}
        ]
      }
    ]
  },
  {
    "description": "compare against the input",
    "policy": {"ergo_spec": "v0.1", "subjects": {"thing": {"from": "things", "identified_by": "id"}}, "requirements": {"s": {"subject": "thing", "checks": {"c": ".a is less than $input.limit"}}}},
    "cases": [
      {
        "description": "names the path into the input",
        "rules": ["compare.inputs", "sentence.print.canonical", "path.start", "path.steps"],
        "input": {"limit": 5, "things": [{"a": 1, "id": "t1"}]},
        "results": [
          {
            "requirement": "s",
            "subject": {"type": "thing", "id": "t1"},
            "check": "c",
            "passed": true,
            "cause": "satisfied",
            "inputs": [{"name": ".a", "value": 1}, {"name": "$input.limit", "value": 5}]
          }
        ],
        "expressions": {"s": {"c": ".a is less than $input.limit"}}
      }
    ]
  }
]
