[
  {
    "description": "equals a string",
    "policy": {"ergo_spec": "v0.4-dev", "subjects": {"thing": {"from": "things", "identified_by": "id"}}, "requirements": {"s": {"subject": "thing", "checks": {"c": "x is \"a\""}}}},
    "cases": [
      {
        "description": "passes on the same string",
        "rules": ["equals.pass", "sentence.print.canonical", "path.inputs"],
        "input": {"things": [{"id": "t1", "x": "a"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": true, "cause": "satisfied", "inputs": [{"name": "x", "value": "a", "locations": ["/things/0/x"]}]}
        ],
        "expressions": {"s": {"c": "x is \"a\""}}
      },
      {
        "description": "fails as value on another string",
        "rules": ["equals.fail"],
        "input": {"things": [{"id": "t1", "x": "b"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": false, "cause": "value", "inputs": [{"name": "x", "value": "b", "locations": ["/things/0/x"]}]}
        ]
      },
      {
        "description": "fails as absent when the field is missing",
        "rules": ["equals.fail", "path.absent"],
        "input": {"things": [{"id": "t1"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": false, "cause": "absent", "inputs": [{"name": "x", "value": null, "locations": ["/things/0"]}]}
        ]
      },
      {
        "description": "fails as null when the field is null",
        "rules": ["equals.fail", "path.null"],
        "input": {"things": [{"id": "t1", "x": null}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": false, "cause": "null", "inputs": [{"name": "x", "value": null, "locations": ["/things/0/x"]}]}
        ]
      }
    ]
  },
  {
    "description": "equals a number",
    "policy": {"ergo_spec": "v0.4-dev", "subjects": {"thing": {"from": "things", "identified_by": "id"}}, "requirements": {"s": {"subject": "thing", "checks": {"c": "x is 1"}}}},
    "cases": [
      {
        "description": "passes on 1.0, because numbers compare by value",
        "rules": ["equals.pass", "value.equal", "sentence.print.canonical", "path.inputs"],
        "input": {"things": [{"id": "t1", "x": 1.0}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": true, "cause": "satisfied", "inputs": [{"name": "x", "value": 1, "locations": ["/things/0/x"]}]}
        ],
        "expressions": {"s": {"c": "x is 1"}}
      },
      {
        "description": "fails as unusable on the string \"1\", because the type must match",
        "rules": ["equals.fail", "value.equal"],
        "input": {"things": [{"id": "t1", "x": "1"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": false, "cause": "unusable", "inputs": [{"name": "x", "value": "1", "locations": ["/things/0/x"]}]}
        ]
      }
    ]
  },
  {
    "description": "equals a number written with an exponent",
    "policy": {"ergo_spec": "v0.4-dev", "subjects": {"thing": {"from": "things", "identified_by": "id"}}, "requirements": {"s": {"subject": "thing", "checks": {"c": "x is 150"}}}},
    "cases": [
      {
        "description": "shows the number in plain decimal",
        "rules": ["sentence.print.canonical", "value.equal", "path.inputs"],
        "input": {"things": [{"id": "t1", "x": 150}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": true, "cause": "satisfied", "inputs": [{"name": "x", "value": 150, "locations": ["/things/0/x"]}]}
        ],
        "expressions": {"s": {"c": "x is 150"}}
      }
    ]
  },
  {
    "description": "equals null",
    "policy": {"ergo_spec": "v0.4-dev", "subjects": {"thing": {"from": "things", "identified_by": "id"}}, "requirements": {"s": {"subject": "thing", "checks": {"c": "x is null"}}}},
    "cases": [
      {
        "description": "passes on a field that is there and null",
        "rules": ["equals.pass", "sentence.print.canonical", "path.inputs"],
        "input": {"things": [{"id": "t1", "x": null}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": true, "cause": "satisfied", "inputs": [{"name": "x", "value": null, "locations": ["/things/0/x"]}]}
        ],
        "expressions": {"s": {"c": "x is null"}}
      },
      {
        "description": "fails as absent on a missing field",
        "rules": ["equals.fail"],
        "input": {"things": [{"id": "t1"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": false, "cause": "absent", "inputs": [{"name": "x", "value": null, "locations": ["/things/0"]}]}
        ]
      }
    ]
  },
  {
    "description": "a position in a list",
    "policy": {"ergo_spec": "v0.4-dev", "subjects": {"thing": {"from": "things", "identified_by": "id"}}, "requirements": {"s": {"subject": "thing", "checks": {"c": "item 2 of x is \"q\""}}}},
    "cases": [
      {
        "description": "points at the item it read",
        "rules": ["location.read", "location.one"],
        "input": {"things": [{"id": "t1", "x": ["p", "q"]}]},
        "results": [
          {"cause": "satisfied", "check": "c", "inputs": [{"locations": ["/things/0/x/1"], "name": "item 2 of x", "value": "q"}], "passed": true, "requirement": "s", "subject": {"id": "t1", "type": "thing"}}
        ]
      },
      {
        "description": "points at the list when it's too short",
        "rules": ["location.read"],
        "input": {"things": [{"id": "t1", "x": ["p"]}]},
        "results": [
          {"cause": "absent", "check": "c", "inputs": [{"locations": ["/things/0/x"], "name": "item 2 of x", "value": null}], "passed": false, "requirement": "s", "subject": {"id": "t1", "type": "thing"}}
        ]
      },
      {
        "description": "points at the object holding a key that looks like the position, not at the value under it",
        "rules": ["location.read"],
        "input": {"things": [{"id": "t1", "x": {"1": "q"}}]},
        "results": [
          {"cause": "unusable", "check": "c", "inputs": [{"locations": ["/things/0/x"], "name": "item 2 of x", "value": null}], "passed": false, "requirement": "s", "subject": {"id": "t1", "type": "thing"}}
        ]
      }
    ]
  },
  {
    "description": "keys that need escaping",
    "policy": {"ergo_spec": "v0.4-dev", "subjects": {"thing": {"from": "things", "identified_by": "id"}}, "requirements": {"s": {"subject": "thing", "checks": {"c": "\"a/b\".\"c~d\" is 1"}}}},
    "cases": [
      {
        "description": "writes a slash as ~1 and a tilde as ~0",
        "rules": ["location"],
        "input": {"things": [{"id": "t1", "a/b": {"c~d": 1}}]},
        "results": [
          {"cause": "satisfied", "check": "c", "inputs": [{"locations": ["/things/0/a~1b/c~0d"], "name": "\"a/b\".\"c~d\"", "value": 1}], "passed": true, "requirement": "s", "subject": {"id": "t1", "type": "thing"}}
        ]
      }
    ]
  },
