    ]
  },
  {
    "description": "a pattern with a Unicode class",
    "policy": {"s": {"subject_type": "thing", "from": ["things"], "id": ["id"], "checks": {"c": {"op": "matches_any", "path": ["x"], "patterns": ["^\\p{L}+$"]}}}},
    "cases": [
