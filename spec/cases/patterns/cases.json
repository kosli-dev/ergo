  {
    "description": "patterns read through a ref to a list",
    "policy": {"ergo_spec": "{{spec}}", "subjects": {"thing": {"from": "things", "identified_by": "id"}}, "requirements": {"s": {"subject": "thing", "checks": {"c": "x matches $params.ps"}}}},
    "params": {"ps": ["c"]},
    "cases": [
      {
        "description": "passes when one matches",
        "rules": ["patterns.list", "sentence.print.canonical"],
        "input": {"things": [{"id": "t1", "x": "abc"}]},
        "results": [
          {
            "cause": "satisfied",
            "check": "c",
            "inputs": [
              {
                "locations": [
                  "/things/0/x"
                ],
                "name": "x",
                "value": "abc"
              },
              {
                "locations": [
                  "$params:/ps"
                ],
                "name": "$params.ps",
                "value": [
                  "c"
                ]
              }
            ],
            "passed": true,
            "requirement": "s",
            "subject": {
              "id": "t1",
              "type": "thing"
            }
          }
        ],
        "expressions": {"s": {"c": "x matches $params.ps"}}
      }
    ]
  },
