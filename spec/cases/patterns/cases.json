[
  {
    "description": "matches_any",
    "policy": {"ergo_spec": "v0.4-dev", "subjects": {"thing": {"from": "things", "identified_by": "id"}}, "requirements": {"s": {"subject": "thing", "checks": {"c": "x matches \"z\", \"^b\", \"svc_\""}}}},
    "cases": [
      {
        "description": "passes when one pattern matches anywhere in the string",
        "rules": ["patterns.pass", "patterns.syntax", "sentence.print.canonical"],
        "input": {"things": [{"id": "t1", "x": "my_svc_x"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": true, "cause": "satisfied", "inputs": [{"name": "x", "value": "my_svc_x", "locations": ["/things/0/x"]}]}
        ],
        "expressions": {"s": {"c": "x matches \"z\", \"^b\", \"svc_\""}}
      },
      {
        "description": "fails as value when none matches",
        "rules": ["patterns.fail"],
        "input": {"things": [{"id": "t1", "x": "a"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": false, "cause": "value", "inputs": [{"name": "x", "value": "a", "locations": ["/things/0/x"]}]}
        ]
      },
      {
        "description": "fails as unusable on a number",
        "rules": ["patterns.fail"],
        "input": {"things": [{"id": "t1", "x": 1}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": false, "cause": "unusable", "inputs": [{"name": "x", "value": 1, "locations": ["/things/0/x"]}]}
        ]
      },
      {
        "description": "fails as absent when the field is missing",
        "rules": ["patterns.fail", "path.absent"],
        "input": {"things": [{"id": "t1"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": false, "cause": "absent", "inputs": [{"name": "x", "value": null, "locations": ["/things/0"]}]}
        ]
      }
    ]
  },
  {
    "description": "not_matches_any",
    "policy": {"ergo_spec": "v0.4-dev", "subjects": {"thing": {"from": "things", "identified_by": "id"}}, "requirements": {"s": {"subject": "thing", "checks": {"c": "x does not match \"^b\""}}}},
    "cases": [
      {
        "description": "passes when no pattern matches",
        "rules": ["patterns.pass", "sentence.print.canonical"],
        "input": {"things": [{"id": "t1", "x": "a"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": true, "cause": "satisfied", "inputs": [{"name": "x", "value": "a", "locations": ["/things/0/x"]}]}
        ],
        "expressions": {"s": {"c": "x does not match \"^b\""}}
      },
      {
        "description": "fails as value when a pattern matches",
        "rules": ["patterns.fail"],
        "input": {"things": [{"id": "t1", "x": "bob"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": false, "cause": "value", "inputs": [{"name": "x", "value": "bob", "locations": ["/things/0/x"]}]}
        ]
      },
      {
        "description": "fails as unusable on a number",
        "rules": ["patterns.fail"],
        "input": {"things": [{"id": "t1", "x": 1}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": false, "cause": "unusable", "inputs": [{"name": "x", "value": 1, "locations": ["/things/0/x"]}]}
        ]
      },
      {
        "description": "fails as absent when the field is missing",
        "rules": ["patterns.fail", "path.absent"],
        "input": {"things": [{"id": "t1"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": false, "cause": "absent", "inputs": [{"name": "x", "value": null, "locations": ["/things/0"]}]}
        ]
      }
    ]
  },
  {
    "description": "a pattern with a dot",
    "policy": {"ergo_spec": "v0.4-dev", "subjects": {"thing": {"from": "things", "identified_by": "id"}}, "requirements": {"s": {"subject": "thing", "checks": {"c": "x matches \"^a.b$\""}}}},
    "cases": [
      {
        "description": "doesn't match a newline",
        "rules": ["patterns.syntax"],
        "input": {"things": [{"id": "t1", "x": "a\nb"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": false, "cause": "value", "inputs": [{"name": "x", "value": "a\nb", "locations": ["/things/0/x"]}]}
        ]
      }
    ]
  },
  {
    "description": "a pattern ending with a dollar",
    "policy": {"ergo_spec": "v0.4-dev", "subjects": {"thing": {"from": "things", "identified_by": "id"}}, "requirements": {"s": {"subject": "thing", "checks": {"c": "x matches \"a$\""}}}},
    "cases": [
      {
        "description": "doesn't match before a final newline",
        "rules": ["patterns.syntax"],
        "input": {"things": [{"id": "t1", "x": "a\n"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": false, "cause": "value", "inputs": [{"name": "x", "value": "a\n", "locations": ["/things/0/x"]}]}
        ]
      }
    ]
  },
  {
    "description": "a case-insensitive pattern",
    "policy": {"ergo_spec": "v0.4-dev", "subjects": {"thing": {"from": "things", "identified_by": "id"}}, "requirements": {"s": {"subject": "thing", "checks": {"c": "x matches \"(?i)^A\""}}}},
    "cases": [
      {
        "description": "matches the other case",
        "rules": ["patterns.syntax"],
        "input": {"things": [{"id": "t1", "x": "abc"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": true, "cause": "satisfied", "inputs": [{"name": "x", "value": "abc", "locations": ["/things/0/x"]}]}
        ]
      }
    ]
  },
  {
    "description": "a pattern with a Unicode class",
    "policy": {"ergo_spec": "v0.4-dev", "subjects": {"thing": {"from": "things", "identified_by": "id"}}, "requirements": {"s": {"subject": "thing", "checks": {"c": "x matches \"^\\\\p{L}+$\""}}}},
    "cases": [
      {
        "description": "matches letters outside ASCII",
        "rules": ["patterns.syntax"],
        "input": {"things": [{"id": "t1", "x": "été"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": true, "cause": "satisfied", "inputs": [{"name": "x", "value": "été", "locations": ["/things/0/x"]}]}
        ]
      }
    ]
  },
  {
    "description": "patterns read through a ref to a list",
    "policy": {"ergo_spec": "v0.4-dev", "subjects": {"thing": {"from": "things", "identified_by": "id"}}, "requirements": {"s": {"subject": "thing", "checks": {"c": "x matches $params.ps"}}}},
    "params": {"ps": ["c"]},
    "cases": [
      {
        "description": "passes when one matches",
        "rules": ["patterns.list", "sentence.print.canonical"],
        "input": {"things": [{"id": "t1", "x": "abc"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": true, "cause": "satisfied", "inputs": [{"name": "x", "value": "abc", "locations": ["/things/0/x"]}]}
        ],
        "expressions": {"s": {"c": "x matches $params.ps"}}
      }
    ]
  },
  {
    "description": "patterns read through a ref that isn't a list",
    "policy": {"ergo_spec": "v0.4-dev", "subjects": {"thing": {"from": "things", "identified_by": "id"}}, "requirements": {"s": {"subject": "thing", "checks": {"c": "x matches $params.ps"}}}},
    "params": {"ps": "c"},
    "cases": [
      {
        "description": "fails as unusable",
        "rules": ["patterns.list"],
        "input": {"things": [{"id": "t1", "x": "abc"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": false, "cause": "unusable", "inputs": [{"name": "x", "value": "abc", "locations": ["/things/0/x"]}]}
        ]
      }
    ]
  },
  {
    "description": "the classes \\d, \\w, \\s and \\b",
    "policy": {"ergo_spec": "v0.4-dev", "subjects": {"thing": {"from": "things", "identified_by": "id"}}, "requirements": {"s": {"subject": "thing", "checks": {"d": "x matches '^\\d$'", "w": "y matches '^\\w$'", "s": "z matches '^\\s+$'", "b": "v matches '^a\\b'"}}}},
    "cases": [
      {
        "description": "only know ASCII, as in RE2, so a digit or a letter outside ASCII doesn't match and a letter outside ASCII ends a word",
        "rules": ["patterns.syntax"],
        "input": {"things": [{"id": "t1", "x": "٣", "y": "é", "z": "\u000b\u00a0", "v": "aé"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "b", "passed": true, "cause": "satisfied", "inputs": [{"name": "v", "value": "aé", "locations": ["/things/0/v"]}]},
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "d", "passed": false, "cause": "value", "inputs": [{"name": "x", "value": "٣", "locations": ["/things/0/x"]}]},
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "s", "passed": false, "cause": "value", "inputs": [{"name": "z", "value": "\u000b\u00a0", "locations": ["/things/0/z"]}]},
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "w", "passed": false, "cause": "value", "inputs": [{"name": "y", "value": "é", "locations": ["/things/0/y"]}]}
        ]
      }
    ]
  }
]
