[
  {
    "description": "matches_any",
    "policy": {"ergo_spec": "{{spec}}", "subjects": {"thing": {"from": "things", "identified_by": "id"}}, "requirements": {"s": {"subject": "thing", "checks": {"c": "x matches \"z\", \"^b\", \"svc_\""}}}},
    "cases": [
      {
        "description": "passes when one pattern matches anywhere in the string",
        "rules": ["patterns.pass", "patterns.syntax", "sentence.print.canonical"],
        "input": {"things": [{"id": "t1", "x": "my_svc_x"}]},
        "results": [
          {
            "cause": "satisfied",
            "check": "c",
            "inputs": [
              {
                "locations": [
                  "/things/0/x"
                ],
                "name": "x",
                "value": "my_svc_x"
              }
            ],
            "passed": true,
            "requirement": "s",
            "subject": {
              "id": "t1",
              "type": "thing"
            }
          }
        ],
        "expressions": {"s": {"c": "x matches \"z\", \"^b\", \"svc_\""}}
      },
      {
        "description": "fails as value when none matches",
        "rules": ["patterns.fail"],
        "input": {"things": [{"id": "t1", "x": "a"}]},
        "results": [
          {
            "cause": "value",
            "check": "c",
            "failures": [
              {
                "cause": "value",
                "failures": [],
                "inputs": [
                  {
                    "locations": [
                      "/things/0/x"
                    ],
                    "name": "x",
                    "outcome": "found",
                    "value": "a"
                  }
                ],
                "kind": "assertion",
                "locations": [
                  "$policy:/requirements/s/checks/c"
                ],
                "message": "x is \"a\"",
                "name": "x matches \"z\", \"^b\", \"svc_\""
              }
            ],
            "inputs": [
              {
                "locations": [
                  "/things/0/x"
                ],
                "name": "x",
                "outcome": "found",
                "value": "a"
              }
            ],
            "message": "x is \"a\"",
            "passed": false,
            "requirement": "s",
            "subject": {
              "id": "t1",
              "type": "thing"
            }
          }
        ]
      },
      {
        "description": "fails as unusable on a number",
        "rules": ["patterns.fail"],
        "input": {"things": [{"id": "t1", "x": 1}]},
        "results": [
          {
            "cause": "unusable",
            "check": "c",
