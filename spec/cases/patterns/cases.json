[
  {
    "description": "matches_any",
    "policy": {"s": {"subject_type": "thing", "from": ["things"], "id": ["id"], "checks": {"c": {"op": "matches_any", "path": ["x"], "patterns": ["z", "^b", "svc_"]}}}},
    "cases": [
      {
        "description": "passes when one pattern matches anywhere in the string",
        "rules": ["patterns.pass", "patterns.syntax", "render.path", "patterns.expression"],
        "input": {"things": [{"id": "t1", "x": "my_svc_x"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": true, "cause": "satisfied", "inputs": [{"name": "x", "value": "my_svc_x"}]}
        ],
        "expressions": {"s": {"c": "x matches one of [\"^b\", \"svc_\", \"z\"]"}}
      },
      {
        "description": "fails as value when none matches",
        "rules": ["patterns.fail"],
        "input": {"things": [{"id": "t1", "x": "a"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": false, "cause": "value", "inputs": [{"name": "x", "value": "a"}]}
        ]
      },
      {
        "description": "fails as unusable on a number",
        "rules": ["patterns.fail"],
        "input": {"things": [{"id": "t1", "x": 1}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": false, "cause": "unusable", "inputs": [{"name": "x", "value": 1}]}
        ]
      },
      {
        "description": "fails as absent when the field is missing",
        "rules": ["patterns.fail", "path.absent"],
        "input": {"things": [{"id": "t1"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": false, "cause": "absent", "inputs": [{"name": "x", "value": null}]}
        ]
      }
    ]
  },
  {
    "description": "not_matches_any",
