  {
    "description": "matches_any written wrong",
    "policy": {
      "s": {
        "subject_type": "thing",
        "from": ["things"],
        "id": ["id"],
        "checks": {
          "backreference": {"op": "matches_any", "path": ["x"], "patterns": ["(a)\\1"]},
          "lookahead": {"op": "matches_any", "path": ["x"], "patterns": ["a(?=b)"]},
          "no_patterns": {"op": "matches_any", "path": ["x"]},
          "not_a_list": {"op": "matches_any", "path": ["x"], "patterns": "a"},
          "not_a_string": {"op": "matches_any", "path": ["x"], "patterns": ["a", 42]},
          "unclosed": {"op": "matches_any", "path": ["x"], "patterns": ["a", "("]}
        }
      }
    },
    "cases": [
      {
        "description": "fails every check as ill_formed and says why",
        "rules": ["patterns.list", "patterns.syntax", "written_wrong", "written_wrong.row", "patterns.written_wrong", "render.path", "patterns.expression"],
        "input": {"things": [{"id": "t1", "x": "a"}]},
        "results": [
          {
            "requirement": "s",
            "subject": {"type": "thing", "id": null},
            "check": "$well_formed",
            "passed": false,
            "cause": "value",
            "inputs": [
              {"name": "count(checks)", "value": 6},
              {"name": "require", "value": "every"},
              {"name": "checks.backreference", "value": ["invalid patterns"]},
              {"name": "checks.lookahead", "value": ["invalid patterns"]},
              {"name": "checks.no_patterns", "value": ["missing patterns"]},
              {"name": "checks.not_a_list", "value": ["invalid patterns"]},
              {"name": "checks.not_a_string", "value": ["invalid patterns"]},
              {"name": "checks.unclosed", "value": ["invalid patterns"]}
            ]
          },
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "backreference", "passed": false, "cause": "ill_formed", "inputs": [{"name": "x", "value": "a"}]},
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "lookahead", "passed": false, "cause": "ill_formed", "inputs": [{"name": "x", "value": "a"}]},
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "no_patterns", "passed": false, "cause": "ill_formed", "inputs": [{"name": "x", "value": "a"}]},
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "not_a_list", "passed": false, "cause": "ill_formed", "inputs": [{"name": "x", "value": "a"}]},
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "not_a_string", "passed": false, "cause": "ill_formed", "inputs": [{"name": "x", "value": "a"}]},
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "unclosed", "passed": false, "cause": "ill_formed", "inputs": [{"name": "x", "value": "a"}]}
        ],
        "expressions": {"s": {"no_patterns": "x matches one of <missing patterns>", "not_a_list": "x matches one of <invalid patterns>"}}
