        "expressions": {"s": {"c": "x matches none of [\"^b\"]"}}
      },
      {
        "description": "fails as value when a pattern matches",
        "rules": ["patterns.fail"],
        "input": {"things": [{"id": "t1", "x": "bob"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": false, "cause": "value", "inputs": [{"name": "x", "value": "bob"}]}
        ]
      },
      {
        "description": "fails as unusable on a number",
