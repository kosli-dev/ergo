          {"cause": "unusable", "check": "c", "inputs": [{"locations": ["/things/0/x"], "name": "x", "value": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaébcd"}], "message": "x is \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaé…\", which isn't a number", "passed": false, "requirement": "s", "subject": {"id": "t1", "type": "thing"}}
        ]
      },
      {
        "description": "text of 60 characters is printed whole",
        "rules": ["message.print"],
        "input": {"things": [{"id": "t1", "x": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"}]},
        "results": [
          {"cause": "unusable", "check": "c", "inputs": [{"locations": ["/things/0/x"], "name": "x", "value": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"}], "message": "x is \"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\", which isn't a number", "passed": false, "requirement": "s", "subject": {"id": "t1", "type": "thing"}}
        ]
      },
      {
        "description": "a list over 3 items shows 3 and how many more",
        "rules": ["message.print"],
        "input": {"things": [{"id": "t1", "x": ["a", "b", "c", "d", "e"]}]},
        "results": [
          {"cause": "unusable", "check": "c", "inputs": [{"locations": ["/things/0/x"], "name": "x", "value": ["a", "b", "c", "d", "e"]}], "message": "x is [\"a\", \"b\", \"c\", and 2 more], which isn't a number", "passed": false, "requirement": "s", "subject": {"id": "t1", "type": "thing"}}
        ]
      },
      {
        "description": "a list of 3 items is printed whole",
        "rules": ["message.print"],
        "input": {"things": [{"id": "t1", "x": ["a", "b", "c"]}]},
        "results": [
          {"cause": "unusable", "check": "c", "inputs": [{"locations": ["/things/0/x"], "name": "x", "value": ["a", "b", "c"]}], "message": "x is [\"a\", \"b\", \"c\"], which isn't a number", "passed": false, "requirement": "s", "subject": {"id": "t1", "type": "thing"}}
        ]
      },
      {
        "description": "a short object is printed whole",
        "rules": ["message.print"],
        "input": {"things": [{"id": "t1", "x": {"b": 1, "a": [true, null]}}]},
        "results": [
          {"cause": "unusable", "check": "c", "inputs": [{"locations": ["/things/0/x"], "name": "x", "value": {"a": [true, null], "b": 1}}], "message": "x is {\"a\": [true, null], \"b\": 1}, which isn't a number", "passed": false, "requirement": "s", "subject": {"id": "t1", "type": "thing"}}
        ]
      },
      {
        "description": "an object whose JSON is over 80 characters gives its number of keys",
        "rules": ["message.print"],
        "input": {"things": [{"id": "t1", "x": {"k0": "value number 0", "k1": "value number 1", "k2": "value number 2", "k3": "value number 3", "k4": "value number 4", "k5": "value number 5"}}]},
        "results": [
          {"cause": "unusable", "check": "c", "inputs": [{"locations": ["/things/0/x"], "name": "x", "value": {"k0": "value number 0", "k1": "value number 1", "k2": "value number 2", "k3": "value number 3", "k4": "value number 4", "k5": "value number 5"}}], "message": "x is an object with 6 keys, which isn't a number", "passed": false, "requirement": "s", "subject": {"id": "t1", "type": "thing"}}
        ]
      }
    ]
  },
  {
    "description": "a worked out value prints only what was compared",
    "policy": {"ergo_spec": "v0.5-dev", "subjects": {"thing": {"from": "things", "identified_by": "id"}}, "requirements": {"s": {"subject": "thing", "checks": {"c": "count of tests is 2", "d": "sum of items.n plus extra is 10"}}}},
    "cases": [
      {
        "description": "count and sum print their result",
        "rules": ["message.worked_out"],
        "input": {"things": [{"id": "t1", "tests": [1], "items": [{"n": 5}, {"n": 4}], "extra": 3}]},
        "results": [
          {"cause": "value", "check": "c", "inputs": [{"locations": ["/things/0/tests/0"], "name": "count of tests", "value": 1}, {"locations": ["/things/0/tests/0"], "name": "tests[]", "value": [1]}], "message": "count of tests is 1", "passed": false, "requirement": "s", "subject": {"id": "t1", "type": "thing"}},
          {"cause": "value", "check": "d", "inputs": [{"locations": ["/things/0/items/0/n", "/things/0/items/1/n", "/things/0/extra"], "name": "sum of items.n plus extra", "value": 12}, {"locations": ["/things/0/items/0/n", "/things/0/items/1/n"], "name": "sum of items.n", "value": 9}, {"locations": ["/things/0/items/0/n", "/things/0/items/1/n"], "name": "items[].n", "value": [5, 4]}, {"locations": ["/things/0/extra"], "name": "extra", "value": 3}], "message": "sum of items.n plus extra is 12", "passed": false, "requirement": "s", "subject": {"id": "t1", "type": "thing"}}
        ]
      }
    ]
  },
