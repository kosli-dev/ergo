[
  {
    "description": "a message says what was found",
    "policy": {"ergo_spec": "v0.5-dev", "subjects": {"thing": {"from": "things", "identified_by": "id"}}, "requirements": {"s": {"subject": "thing", "checks": {"c": "x is 3"}}}},
    "cases": [
      {
        "description": "a passed row has no message",
        "rules": ["message.row"],
        "input": {"things": [{"id": "t1", "x": 3}]},
        "results": [
          {"cause": "satisfied", "check": "c", "inputs": [{"locations": ["/things/0/x"], "name": "x", "value": 3}], "passed": true, "requirement": "s", "subject": {"id": "t1", "type": "thing"}}
        ]
      },
      {
        "description": "a failed row names the value it found, not the one it wanted",
        "rules": ["message.row", "message.value"],
        "input": {"things": [{"id": "t1", "x": 4}]},
        "results": [
          {"cause": "value", "check": "c", "inputs": [{"locations": ["/things/0/x"], "name": "x", "value": 4}], "message": "x is 4", "passed": false, "requirement": "s", "subject": {"id": "t1", "type": "thing"}}
        ]
      },
      {
        "description": "a missing field is missing",
        "rules": ["message.cause"],
        "input": {"things": [{"id": "t1"}]},
        "results": [
          {"cause": "absent", "check": "c", "inputs": [{"locations": ["/things/0"], "name": "x", "value": null}], "message": "x is missing", "passed": false, "requirement": "s", "subject": {"id": "t1", "type": "thing"}}
        ]
      },
      {
        "description": "a null field is null",
        "rules": ["message.cause"],
        "input": {"things": [{"id": "t1", "x": null}]},
        "results": [
          {"cause": "null", "check": "c", "inputs": [{"locations": ["/things/0/x"], "name": "x", "value": null}], "message": "x is null", "passed": false, "requirement": "s", "subject": {"id": "t1", "type": "thing"}}
        ]
      },
      {
        "description": "a field of another type says which kind it isn't",
        "rules": ["message.cause"],
        "input": {"things": [{"id": "t1", "x": "3"}]},
        "results": [
          {"cause": "unusable", "check": "c", "inputs": [{"locations": ["/things/0/x"], "name": "x", "value": "3"}], "message": "x is \"3\", which isn't a number", "passed": false, "requirement": "s", "subject": {"id": "t1", "type": "thing"}}
        ]
      },
      {
        "description": "a subject that isn't an object says so",
        "rules": ["message.cause"],
        "input": {"things": ["t1"]},
        "results": [
          {"cause": "not_an_object", "check": "c", "inputs": [{"locations": ["/things/0"], "name": "x", "value": null}], "message": "it is \"t1\", which isn't an object", "passed": false, "requirement": "s", "subject": {"id": "t1", "type": "thing"}}
        ]
      }
    ]
  },
  {
    "description": "a message on two values joins them with and",
    "policy": {"ergo_spec": "v0.5-dev", "subjects": {"thing": {"from": "things", "identified_by": "id"}}, "requirements": {"s": {"subject": "thing", "checks": {"c": "approver is not author"}}}},
    "cases": [
      {
        "description": "both values are named",
        "rules": ["message.value"],
        "input": {"things": [{"id": "t1", "approver": "ana", "author": "ana"}]},
        "results": [
          {"cause": "value", "check": "c", "inputs": [{"locations": ["/things/0/approver"], "name": "approver", "value": "ana"}, {"locations": ["/things/0/author"], "name": "author", "value": "ana"}], "message": "approver is \"ana\", and author is \"ana\"", "passed": false, "requirement": "s", "subject": {"id": "t1", "type": "thing"}}
        ]
      },
      {
        "description": "only the input that is missing is named",
        "rules": ["message.cause"],
        "input": {"things": [{"id": "t1", "author": "ana"}]},
        "results": [
          {"cause": "absent", "check": "c", "inputs": [{"locations": ["/things/0"], "name": "approver", "value": null}, {"locations": ["/things/0/author"], "name": "author", "value": "ana"}], "message": "approver is missing", "passed": false, "requirement": "s", "subject": {"id": "t1", "type": "thing"}}
        ]
      }
    ]
  },
  {
    "description": "a message prints a value as JSON, cut when it is long",
