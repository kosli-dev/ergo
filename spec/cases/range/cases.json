[
  {
    "description": "range between two numbers",
    "policy": {"ergo_spec": "v0.4-dev", "subjects": {"thing": {"from": "things", "identified_by": "id"}}, "requirements": {"s": {"subject": "thing", "checks": {"c": "x is between 1 and 3"}}}},
    "cases": [
      {
        "description": "passes inside the range",
        "rules": ["range.pass", "sentence.print.canonical"],
        "input": {"things": [{"id": "t1", "x": 2}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": true, "cause": "satisfied", "inputs": [{"name": "x", "value": 2, "locations": ["/things/0/x"]}]}
        ],
        "expressions": {"s": {"c": "x is between 1 and 3"}}
      },
      {
        "description": "passes on min",
        "rules": ["range.pass"],
        "input": {"things": [{"id": "t1", "x": 1}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": true, "cause": "satisfied", "inputs": [{"name": "x", "value": 1, "locations": ["/things/0/x"]}]}
        ]
      },
      {
        "description": "passes on max written as 3.0",
        "rules": ["range.pass", "value.equal"],
        "input": {"things": [{"id": "t1", "x": 3.0}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": true, "cause": "satisfied", "inputs": [{"name": "x", "value": 3, "locations": ["/things/0/x"]}]}
        ]
      },
      {
        "description": "fails as value below min",
        "rules": ["range.fail"],
        "input": {"things": [{"id": "t1", "x": 0.5}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": false, "cause": "value", "inputs": [{"name": "x", "value": 0.5, "locations": ["/things/0/x"]}]}
        ]
      },
      {
        "description": "fails as value above max",
        "rules": ["range.fail"],
        "input": {"things": [{"id": "t1", "x": 4}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": false, "cause": "value", "inputs": [{"name": "x", "value": 4, "locations": ["/things/0/x"]}]}
        ]
      },
      {
        "description": "fails as unusable on a string that holds a number",
        "rules": ["range.fail"],
        "input": {"things": [{"id": "t1", "x": "2"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": false, "cause": "unusable", "inputs": [{"name": "x", "value": "2", "locations": ["/things/0/x"]}]}
        ]
      },
      {
        "description": "fails as absent when the field is missing",
        "rules": ["range.fail", "path.absent"],
        "input": {"things": [{"id": "t1"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": false, "cause": "absent", "inputs": [{"name": "x", "value": null, "locations": ["/things/0"]}]}
        ]
      }
    ]
  },
  {
    "description": "range with bounds written in other forms",
    "policy": {"ergo_spec": "v0.4-dev", "subjects": {"thing": {"from": "things", "identified_by": "id"}}, "requirements": {"s": {"subject": "thing", "checks": {"c": "x is between 1.5 and 20"}}}},
    "cases": [
