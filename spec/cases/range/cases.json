        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": true, "cause": "satisfied", "inputs": [{"name": "x", "value": 2, "locations": ["/things/0/x"]}]}
        ],
        "expressions": {"s": {"c": "x is between 1.5 and 20"}}
