[
  {
    "description": "range between two numbers",
    "policy": {"ergo_spec": "{{spec}}", "subjects": {"thing": {"from": "things", "identified_by": "id"}}, "requirements": {"s": {"subject": "thing", "checks": {"c": "x is between 1 and 3"}}}},
    "cases": [
      {
        "description": "passes inside the range",
        "rules": ["range.pass", "sentence.print.canonical"],
        "input": {"things": [{"id": "t1", "x": 2}]},
        "results": [
          {
            "cause": "satisfied",
            "check": "c",
            "inputs": [
              {
                "locations": [
                  "/things/0/x"
                ],
                "name": "x",
                "value": 2
              }
            ],
            "passed": true,
            "requirement": "s",
            "subject": {
              "id": "t1",
              "type": "thing"
            }
          }
        ],
        "expressions": {"s": {"c": "x is between 1 and 3"}}
      },
      {
        "description": "passes on min",
        "rules": ["range.pass"],
        "input": {"things": [{"id": "t1", "x": 1}]},
        "results": [
          {
            "cause": "satisfied",
            "check": "c",
            "inputs": [
              {
                "locations": [
                  "/things/0/x"
                ],
                "name": "x",
                "value": 1
              }
            ],
            "passed": true,
            "requirement": "s",
            "subject": {
              "id": "t1",
              "type": "thing"
            }
          }
        ]
      },
      {
        "description": "passes on max written as 3.0",
        "rules": ["range.pass", "value.equal"],
        "input": {"things": [{"id": "t1", "x": 3.0}]},
        "results": [
          {
            "cause": "satisfied",
            "check": "c",
            "inputs": [
              {
                "locations": [
                  "/things/0/x"
                ],
                "name": "x",
                "value": 3
              }
            ],
            "passed": true,
            "requirement": "s",
            "subject": {
              "id": "t1",
              "type": "thing"
            }
          }
        ]
      },
      {
        "description": "fails as value below min",
        "rules": ["range.fail"],
        "input": {"things": [{"id": "t1", "x": 0.5}]},
        "results": [
          {
            "cause": "value",
            "check": "c",
            "failures": [
              {
                "cause": "value",
                "failures": [],
                "inputs": [
                  {
                    "locations": [
                      "/things/0/x"
                    ],
                    "name": "x",
                    "outcome": "found",
                    "value": 0.5
                  }
                ],
                "kind": "assertion",
                "locations": [
                  "$policy:/requirements/s/checks/c"
                ],
                "message": "x is 0.5",
                "name": "x is between 1 and 3"
              }
            ],
            "inputs": [
              {
                "locations": [
                  "/things/0/x"
                ],
                "name": "x",
                "outcome": "found",
                "value": 0.5
              }
            ],
            "message": "x is 0.5",
            "passed": false,
            "requirement": "s",
            "subject": {
              "id": "t1",
              "type": "thing"
            }
          }
        ]
      },
      {
        "description": "fails as value above max",
        "rules": ["range.fail"],
        "input": {"things": [{"id": "t1", "x": 4}]},
        "results": [
          {
            "cause": "value",
            "check": "c",
            "failures": [
              {
                "cause": "value",
                "failures": [],
                "inputs": [
                  {
                    "locations": [
                      "/things/0/x"
                    ],
                    "name": "x",
                    "outcome": "found",
                    "value": 4
                  }
                ],
                "kind": "assertion",
                "locations": [
                  "$policy:/requirements/s/checks/c"
                ],
                "message": "x is 4",
                "name": "x is between 1 and 3"
              }
            ],
            "inputs": [
              {
                "locations": [
                  "/things/0/x"
                ],
                "name": "x",
                "outcome": "found",
                "value": 4
              }
            ],
            "message": "x is 4",
            "passed": false,
            "requirement": "s",
            "subject": {
              "id": "t1",
              "type": "thing"
            }
          }
        ]
      },
      {
        "description": "fails as unusable on a string that holds a number",
        "rules": ["range.fail"],
        "input": {"things": [{"id": "t1", "x": "2"}]},
        "results": [
          {
            "cause": "unusable",
            "check": "c",
            "failures": [
              {
                "cause": "unusable",
                "failures": [],
                "inputs": [
                  {
                    "locations": [
                      "/things/0/x"
                    ],
                    "name": "x",
                    "outcome": "found",
                    "value": "2"
                  }
                ],
                "kind": "assertion",
                "locations": [
                  "$policy:/requirements/s/checks/c"
                ],
                "message": "x is \"2\", which isn't a number",
                "name": "x is between 1 and 3"
              }
            ],
            "inputs": [
              {
                "locations": [
                  "/things/0/x"
                ],
                "name": "x",
                "outcome": "found",
                "value": "2"
              }
            ],
            "message": "x is \"2\", which isn't a number",
            "passed": false,
            "requirement": "s",
            "subject": {
              "id": "t1",
              "type": "thing"
            }
          }
        ]
      },
      {
        "description": "fails as absent when the field is missing",
        "rules": ["range.fail", "path.absent"],
        "input": {"things": [{"id": "t1"}]},
        "results": [
          {
            "cause": "absent",
            "check": "c",
            "failures": [
              {
                "cause": "absent",
                "failures": [],
                "inputs": [
                  {
                    "locations": [
                      "/things/0"
                    ],
                    "name": "x",
                    "outcome": "absent",
                    "value": null
                  }
                ],
                "kind": "assertion",
                "locations": [
                  "$policy:/requirements/s/checks/c"
                ],
                "message": "x is missing",
                "name": "x is between 1 and 3"
              }
            ],
            "inputs": [
              {
                "locations": [
                  "/things/0"
                ],
                "name": "x",
                "outcome": "absent",
                "value": null
              }
            ],
            "message": "x is missing",
            "passed": false,
            "requirement": "s",
            "subject": {
              "id": "t1",
              "type": "thing"
            }
          }
        ]
      }
    ]
  },
  {
    "description": "range with bounds written in other forms",
