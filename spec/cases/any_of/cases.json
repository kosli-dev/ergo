[
  {
    "description": "any_of",
    "policy": {
      "ergo_spec": "v0.2-dev",
      "subjects": {
        "thing": {
          "from": "things",
          "identified_by": "id"
          }
      },
      "requirements": {
        "s": {
          "subject": "thing",
          "checks": {
            "c": {"any_of": {"safe": "type is \"Chore\"", "standard": ["type is \"Story\"", "state is \"Done\""]}}
          }
        }
      }
    },
    "cases": [
      {
        "description": "passes when every check of one option passes",
        "rules": ["any_of.pass", "any_of.inputs", "sentence.print.canonical"],
        "input": {"things": [{"id": "t1", "type": "Chore"}]},
        "results": [
          {
            "requirement": "s",
            "subject": {"type": "thing", "id": "t1"},
            "check": "c",
            "passed": true,
            "cause": "satisfied",
            "inputs": [{"name": "state", "value": null, "locations": ["/things/0"]}, {"name": "type", "value": "Chore", "locations": ["/things/0/type"]}]
          }
        ],
        "expressions": {"s": {"c": "one of: safe(type is \"Chore\") | standard(type is \"Story\" and state is \"Done\")"}}
      },
      {
        "description": "fails as value when no option passes",
        "rules": ["any_of.cause"],
        "input": {"things": [{"id": "t1", "state": "Open", "type": "Story"}]},
        "results": [
          {
            "requirement": "s",
            "subject": {"type": "thing", "id": "t1"},
            "check": "c",
            "passed": false,
            "cause": "value",
            "inputs": [{"name": "state", "value": "Open", "locations": ["/things/0/state"]}, {"name": "type", "value": "Story", "locations": ["/things/0/type"]}]
          }
        ]
      },
      {
        "description": "fails as absent when a field an option needs is missing",
        "rules": ["any_of.cause"],
        "input": {"things": [{"id": "t1", "state": "Done"}]},
        "results": [
          {
            "requirement": "s",
            "subject": {"type": "thing", "id": "t1"},
            "check": "c",
            "passed": false,
            "cause": "absent",
            "inputs": [{"name": "state", "value": "Done", "locations": ["/things/0/state"]}, {"name": "type", "value": null, "locations": ["/things/0"]}]
          }
        ]
      }
    ]
  },
  {
    "description": "any_of with a present check in an option",
    "policy": {
      "ergo_spec": "v0.2-dev",
      "subjects": {
        "thing": {
          "from": "things",
          "identified_by": "id"
          }
      },
      "requirements": {
        "s": {
          "subject": "thing",
          "checks": {"c": {"any_of": {"a": ["x exists", "x is 1"], "b": "y is 1"}}}
        }
      }
    },
    "cases": [
      {
        "description": "settles that option as value when the field is missing",
        "rules": ["any_of.cause", "present.missing"],
        "input": {"things": [{"id": "t1", "y": 2}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": false, "cause": "value", "inputs": [{"name": "x", "value": null, "locations": ["/things/0"]}, {"name": "y", "value": 2, "locations": ["/things/0/y"]}]}
        ]
      }
    ]
  },
  {
    "description": "any_of with a name that starts like another",
    "policy": {
      "ergo_spec": "v0.2-dev",
      "subjects": {
        "thing": {
          "from": "things",
          "identified_by": "id"
          }
      },
      "requirements": {
        "s": {
          "subject": "thing",
          "checks": {
            "c": {"any_of": {"a!": "x is 2", "a": "x is 1", "a b": "x is 3"}}
          }
        }
      }
    },
    "cases": [
      {
        "description": "sorts its options by name, not by the text they print",
        "rules": ["sentence.print.canonical"],
        "input": {
          "things": [
            {
              "id": "t1",
              "x": 1
            }
          ]
        },
        "results": [
          {
            "cause": "satisfied",
            "check": "c",
            "inputs": [
              {
                "name": "x",
                "value": 1,
                "locations": [
                  "/things/0/x"
                ]
              }
            ],
            "passed": true,
            "requirement": "s",
            "subject": {
              "id": "t1",
              "type": "thing"
            }
          }
        ],
        "expressions": {
          "s": {
            "c": "one of: a(x is 1) | a b(x is 3) | a!(x is 2)"
          }
        }
      }
    ]
  },
  {
    "description": "any_of with a ref to a missing param",
    "policy": {
      "ergo_spec": "v0.2-dev",
      "subjects": {
        "thing": {
          "from": "things",
          "identified_by": "id"
          }
      },
      "requirements": {
        "s": {
          "subject": "thing",
          "checks": {
            "c": {"any_of": {"one": "x is 1", "listed": "x is one of $params.l"}}
          }
        }
      }
    },
    "cases": [
      {
        "description": "fails only the option that reads it",
        "rules": ["any_of.refs", "value.ref"],
        "input": {
          "things": [
            {
              "id": "t1",
              "x": 1
            },
            {
              "id": "t2",
              "x": 2
            }
          ]
        },
        "results": [
          {
            "cause": "satisfied",
            "check": "c",
            "inputs": [
              {
                "name": "x",
                "value": 1,
                "locations": [
                  "/things/0/x"
                ]
              }
            ],
            "passed": true,
            "requirement": "s",
            "subject": {
              "id": "t1",
              "type": "thing"
            }
          },
          {
            "cause": "absent",
            "check": "c",
            "inputs": [
              {
                "name": "x",
                "value": 2,
                "locations": [
                  "/things/1/x"
                ]
              }
            ],
            "passed": false,
            "requirement": "s",
            "subject": {
              "id": "t2",
              "type": "thing"
            }
          }
        ]
      }
    ]
  },
  {
    "description": "any_of with a ref to a param of the wrong type",
    "policy": {
      "ergo_spec": "v0.2-dev",
      "subjects": {
        "thing": {
          "from": "things",
          "identified_by": "id"
          }
      },
      "requirements": {
        "s": {
          "subject": "thing",
          "checks": {
            "c": {"any_of": {"one": "x is 1", "listed": "x is one of $params.l"}}
          }
        }
      }
    },
    "params": {
      "l": "text"
    },
    "cases": [
      {
        "description": "fails the row as unusable even when another option passes",
        "rules": ["any_of.refs", "in.values"],
        "input": {
          "things": [
            {
              "id": "t1",
              "x": 1
            }
          ]
        },
        "results": [
          {
            "cause": "unusable",
            "check": "c",
            "inputs": [
              {
                "name": "x",
                "value": 1,
                "locations": [
                  "/things/0/x"
                ]
              }
            ],
            "passed": false,
            "requirement": "s",
            "subject": {
              "id": "t1",
              "type": "thing"
            }
          }
        ]
      }
    ]
  },
  {
    "description": "a check with several assertions that read the same field",
    "policy": {"ergo_spec": "v0.2-dev", "subjects": {"thing": {"from": "things", "identified_by": "id"}}, "requirements": {"s": {"subject": "thing", "checks": {"c": {"assert": ["x exists", "x is 1"]}}}}},
    "cases": [
      {
        "description": "lists the field once, with its location",
        "rules": ["location.merged"],
        "input": {"things": [{"id": "t1", "x": 1}]},
        "results": [
          {"cause": "satisfied", "check": "c", "failed_assertions": [], "inputs": [{"locations": ["/things/0/x"], "name": "x", "value": 1}], "passed": true, "requirement": "s", "subject": {"id": "t1", "type": "thing"}}
        ]
      }
    ]
  }
]
