          {
            "requirement": "s",
            "subject": {"type": "thing", "id": "t1"},
            "check": "no_check",
            "passed": false,
            "cause": "ill_formed",
            "inputs": [],
            "failed_items": [{"cause": "ill_formed", "path": "cs[0]", "value": 1}]
