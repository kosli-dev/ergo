        "rules": ["missing.fail"],
        "input": {"things": [{"id": "t1", "x": false}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": false, "cause": "value", "inputs": [{"name": "x", "value": false, "locations": ["/things/0/x"]}]}
        ]
      },
      {
        "description": "fails as value on an empty string",
        "rules": ["missing.fail"],
        "input": {"things": [{"id": "t1", "x": ""}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": false, "cause": "value", "inputs": [{"name": "x", "value": "", "locations": ["/things/0/x"]}]}
        ]
      },
      {
        "description": "fails as not_an_object when the subject isn't an object",
        "rules": ["missing.fail", "path.not_an_object"],
        "input": {"things": ["t1"]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": false, "cause": "not_an_object", "inputs": [{"name": "x", "value": null, "locations": ["/things/0"]}]}
