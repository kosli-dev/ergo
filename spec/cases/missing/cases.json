        "rules": ["missing.pass", "sentence.print.canonical", "path.inputs"],
        "input": {"things": [{"id": "t1"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": true, "cause": "satisfied", "inputs": [{"name": "x", "value": null, "locations": ["/things/0"]}]}
        ],
        "expressions": {"s": {"c": "x does not exist"}}
      },
      {
        "description": "passes when the field is null",
        "rules": ["missing.pass"],
        "input": {"things": [{"id": "t1", "x": null}]},
