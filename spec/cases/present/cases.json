  {
    "description": "present as a filter",
    "policy": {
      "ergo_spec": "v0.4-dev",
      "subjects": {
        "thing": {
          "from": "things whose status is \"COMPLETE\" and status exists",
          "identified_by": "id"
          }
      },
      "requirements": {
        "s": {
          "subject": "thing",
          "min_subjects": 0,
          "checks": {"c": "x exists"}
        }
      }
    },
    "cases": [
      {
        "description": "rules a subject out when the field is missing, even though the other filter can't read it",
        "rules": ["present.filter", "applies.inputs", "scope.failures"],
        "input": {"things": [{"id": "t1"}]},
        "status": {"s": "not_applicable"},
        "compliant": true,
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "$applies", "passed": false, "cause": "value", "inputs": [{"name": "status", "value": null, "locations": ["/things/0"]}], "failed_assertions": [{"assertion": "status is \"COMPLETE\"", "cause": "absent"}, {"assertion": "status exists", "cause": "value"}]}
        ]
      },
      {
        "description": "rules a subject out when the field is null",
        "rules": ["present.filter", "applies.inputs"],
        "input": {"things": [{"id": "t1", "status": null}]},
        "status": {"s": "not_applicable"},
        "compliant": true,
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "$applies", "passed": false, "cause": "value", "inputs": [{"name": "status", "value": null, "locations": ["/things/0/status"]}], "failed_assertions": [{"assertion": "status is \"COMPLETE\"", "cause": "null"}, {"assertion": "status exists", "cause": "value"}]}
        ]
      },
      {
        "description": "keeps a subject in scope when the field is there",
        "rules": ["present.filter", "applies.inputs"],
        "input": {"things": [{"id": "t1", "status": "COMPLETE", "x": 1}]},
        "status": {"s": "met"},
        "compliant": true,
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "$applies", "passed": true, "cause": "satisfied", "inputs": [{"name": "status", "value": "COMPLETE", "locations": ["/things/0/status"]}], "failed_assertions": []},
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": true, "cause": "satisfied", "inputs": [{"name": "x", "value": 1, "locations": ["/things/0/x"]}]}
        ]
      }
    ]
  },
