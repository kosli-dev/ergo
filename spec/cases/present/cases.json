  {
    "description": "present on the input and with a ref step",
    "policy": {
      "ergo_spec": "v0.4-dev",
      "subjects": {
        "thing": {
          "from": "things",
          "identified_by": "id"
          }
      },
      "requirements": {
        "s": {
          "subject": "thing",
          "checks": {"by_ref": "x named by $params.key exists", "on_input": "$input.flag exists"}
        }
      }
    },
    "params": {"key": "a"},
    "cases": [
      {
        "description": "both pass when the fields are there",
        "rules": ["present.pass", "path.start", "path.ref_step", "path.inputs", "name.ref_step", "path.steps"],
        "input": {"flag": true, "things": [{"id": "t1", "x": {"a": 1}}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "by_ref", "passed": true, "cause": "satisfied", "inputs": [{"name": "x named by $params.key", "value": 1, "locations": ["/things/0/x/a"]}]},
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "on_input", "passed": true, "cause": "satisfied", "inputs": [{"name": "$input.flag", "value": true, "locations": ["/flag"]}]}
        ]
      },
      {
        "description": "both fail as value when the fields are missing",
        "rules": ["present.missing", "path.start", "path.ref_step", "name.ref_step", "path.steps"],
        "input": {"things": [{"id": "t1", "x": {}}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "by_ref", "passed": false, "cause": "value", "inputs": [{"name": "x named by $params.key", "value": null, "locations": ["/things/0/x"]}]},
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "on_input", "passed": false, "cause": "value", "inputs": [{"name": "$input.flag", "value": null, "locations": [""]}]}
        ]
      }
    ]
  },
