          {"cause": "unusable", "check": "not_in", "inputs": [{"locations": ["/things/0/x"], "name": "x", "value": "click"}], "message": "$input.sbom.components is \"x\", which isn't an object", "passed": false, "requirement": "s", "subject": {"id": "t1", "type": "thing"}}
        ]
      }
    ]
