  {
    "description": "a ref on the right side that walks two lists, or reads past what the items hold",
    "policy": {"ergo_spec": "v0.5-dev", "subjects": {"thing": {"from": "things", "identified_by": "id"}}, "requirements": {"s": {"subject": "thing", "checks": {"in": "x is in $input.a.b.c", "deep": "x is in $input.a.b.c.d"}}}},
    "cases": [
      {
        "description": "lists a list for each list it walks",
        "rules": ["walk.right", "compare.list", "sentence.phrase.one_of", "walk.right.inputs"],
