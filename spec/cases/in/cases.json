[
  {
    "description": "in a list",
    "policy": {"subjects": {"thing": {"from": ["things"], "identified_by": ["id"]}}, "requirements": {"s": {"subject": "thing", "checks": {"c": {"op": "in", "path": ["x"], "values": ["b", "a"]}}}}},
    "cases": [
      {
        "description": "passes when the field is one of the values",
        "rules": ["in.pass", "render.path", "in.expression", "path.inputs"],
        "input": {"things": [{"id": "t1", "x": "b"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": true, "cause": "satisfied", "inputs": [{"name": "x", "value": "b"}]}
        ],
        "expressions": {"s": {"c": "x in [\"a\", \"b\"]"}}
      },
      {
        "description": "fails as value when it is none of them",
        "rules": ["in.fail"],
        "input": {"things": [{"id": "t1", "x": "c"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": false, "cause": "value", "inputs": [{"name": "x", "value": "c"}]}
        ]
      },
      {
        "description": "fails as unusable when the field has another type than the values",
        "rules": ["in.fail"],
        "input": {"things": [{"id": "t1", "x": 1}, {"id": "t2", "x": true}, {"id": "t3", "x": ["b"]}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": false, "cause": "unusable", "inputs": [{"name": "x", "value": 1}]},
          {"requirement": "s", "subject": {"type": "thing", "id": "t2"}, "check": "c", "passed": false, "cause": "unusable", "inputs": [{"name": "x", "value": true}]},
          {"requirement": "s", "subject": {"type": "thing", "id": "t3"}, "check": "c", "passed": false, "cause": "unusable", "inputs": [{"name": "x", "value": ["b"]}]}
        ]
      }
    ]
  },
  {
    "description": "in a list of numbers",
    "policy": {"subjects": {"thing": {"from": ["things"], "identified_by": ["id"]}}, "requirements": {"s": {"subject": "thing", "checks": {"c": {"op": "in", "path": ["x"], "values": [1, 2]}}}}},
    "cases": [
      {
        "description": "passes on 1.0, because numbers compare by value",
        "rules": ["in.pass", "value.equal"],
        "input": {"things": [{"id": "t1", "x": 1.0}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": true, "cause": "satisfied", "inputs": [{"name": "x", "value": 1}]}
        ]
      },
      {
        "description": "fails as unusable on the string \"1\"",
        "rules": ["in.fail"],
        "input": {"things": [{"id": "t1", "x": "1"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": false, "cause": "unusable", "inputs": [{"name": "x", "value": "1"}]}
        ]
      }
    ]
  },
  {
    "description": "in a list holding null",
    "policy": {"subjects": {"thing": {"from": ["things"], "identified_by": ["id"]}}, "requirements": {"s": {"subject": "thing", "checks": {"c": {"op": "in", "path": ["x"], "values": ["a", null]}}}}},
    "cases": [
      {
        "description": "fails as absent on a missing field",
        "rules": ["in.fail", "path.inputs"],
        "input": {"things": [{"id": "t1"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": false, "cause": "absent", "inputs": [{"name": "x", "value": null}]}
        ]
      },
      {
        "description": "fails as null on a null field",
        "rules": ["in.fail"],
        "input": {"things": [{"id": "t1", "x": null}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": false, "cause": "null", "inputs": [{"name": "x", "value": null}]}
        ]
      },
      {
        "description": "passes on a field that is one of the other values, since null doesn't count as a type",
        "rules": ["in.values", "in.pass"],
        "input": {"things": [{"id": "t1", "x": "a"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": true, "cause": "satisfied", "inputs": [{"name": "x", "value": "a"}]}
        ]
      }
    ]
  },
  {
    "description": "in an empty list",
    "policy": {"subjects": {"thing": {"from": ["things"], "identified_by": ["id"]}}, "requirements": {"s": {"subject": "thing", "checks": {"c": {"op": "in", "path": ["x"], "values": []}}}}},
    "cases": [
      {
        "description": "fails as value",
        "rules": ["in.fail", "render.path", "in.expression", "path.inputs"],
        "input": {"things": [{"id": "t1", "x": "a"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": false, "cause": "value", "inputs": [{"name": "x", "value": "a"}]}
        ],
        "expressions": {"s": {"c": "x in []"}}
      }
    ]
  },
  {
    "description": "in strings and a ref",
    "policy": {
      "subjects": {
        "thing": {
          "from": ["things"],
          "identified_by": ["id"]
        }
      },
      "requirements": {
        "s": {
          "subject": "thing",
          "checks": {"c": {"op": "in", "path": ["x"], "values": ["a", "10", {"ref": ["$$params", "w"]}, "2", "B"]}}
        }
      }
    },
    "params": {"w": "z"},
    "cases": [
      {
        "description": "are shown sorted by the text they're shown as",
        "rules": ["in.expression", "render.path", "path.inputs"],
        "input": {"things": [{"id": "t1", "x": "B"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": true, "cause": "satisfied", "inputs": [{"name": "x", "value": "B"}]}
        ],
        "expressions": {"s": {"c": "x in [\"10\", \"2\", \"B\", \"a\", $params.w]"}}
      }
    ]
  },
  {
    "description": "in values with a ref among them",
    "policy": {"subjects": {"thing": {"from": ["things"], "identified_by": ["id"]}}, "requirements": {"s": {"subject": "thing", "checks": {"c": {"op": "in", "path": ["x"], "values": [{"ref": ["$$params", "want"]}, "z"]}}}}},
    "params": {},
    "cases": [
      {
        "description": "fails as absent when the ref can't be read, even when another value matches",
        "rules": ["value.ref", "in.values", "path.inputs"],
        "input": {"things": [{"id": "t1", "x": "z"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": false, "cause": "absent", "inputs": [{"name": "x", "value": "z"}]}
        ]
      }
    ]
  },
  {
    "description": "in values read through a ref",
    "policy": {"subjects": {"thing": {"from": ["things"], "identified_by": ["id"]}}, "requirements": {"s": {"subject": "thing", "checks": {"c": {"op": "in", "path": ["x"], "values": {"ref": ["$$params", "allowed"]}}}}}},
    "params": {"allowed": ["a", "b"]},
    "cases": [
      {
        "description": "passes when the field is in the list",
        "rules": ["in.values", "in.pass", "render.path", "in.expression", "path.inputs"],
        "input": {"things": [{"id": "t1", "x": "a"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": true, "cause": "satisfied", "inputs": [{"name": "x", "value": "a"}]}
        ],
        "expressions": {"s": {"c": "x in $params.allowed"}}
      }
    ]
  },
  {
    "description": "in values read through a ref that isn't a list",
    "policy": {"subjects": {"thing": {"from": ["things"], "identified_by": ["id"]}}, "requirements": {"s": {"subject": "thing", "checks": {"c": {"op": "in", "path": ["x"], "values": {"ref": ["$$params", "allowed"]}}}}}},
    "params": {"allowed": "a"},
    "cases": [
      {
        "description": "fails as unusable",
        "rules": ["in.values", "path.inputs"],
        "input": {"things": [{"id": "t1", "x": "a"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": false, "cause": "unusable", "inputs": [{"name": "x", "value": "a"}]}
        ]
      }
    ]
  },
  {
    "description": "in values with a ref among them that reads another type",
    "policy": {"subjects": {"thing": {"from": ["things"], "identified_by": ["id"]}}, "requirements": {"s": {"subject": "thing", "checks": {"c": {"op": "in", "path": ["x"], "values": ["a", {"ref": ["$$params", "want"]}]}}}}},
    "params": {"want": 1},
    "cases": [
      {
        "description": "fails as unusable, even when the field is one of the values or missing",
        "rules": ["in.values", "path.inputs"],
        "input": {"things": [{"id": "t1", "x": "a"}, {"id": "t2"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": false, "cause": "unusable", "inputs": [{"name": "x", "value": "a"}]},
          {"requirement": "s", "subject": {"type": "thing", "id": "t2"}, "check": "c", "passed": false, "cause": "unusable", "inputs": [{"name": "x", "value": null}]}
        ]
      }
    ]
  },
  {
    "description": "in values read through a ref that holds values of mixed types",
    "policy": {"subjects": {"thing": {"from": ["things"], "identified_by": ["id"]}}, "requirements": {"s": {"subject": "thing", "checks": {"c": {"op": "in", "path": ["x"], "values": {"ref": ["$$params", "allowed"]}}}}}},
    "params": {"allowed": ["a", 1]},
    "cases": [
      {
        "description": "fails as unusable, even when the field is one of them or missing",
        "rules": ["in.values", "path.inputs"],
        "input": {"things": [{"id": "t1", "x": "a"}, {"id": "t2"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": false, "cause": "unusable", "inputs": [{"name": "x", "value": "a"}]},
          {"requirement": "s", "subject": {"type": "thing", "id": "t2"}, "check": "c", "passed": false, "cause": "unusable", "inputs": [{"name": "x", "value": null}]}
        ]
      }
    ]
  },
  {
    "description": "is not one of a list",
    "policy": {"subjects": {"thing": {"from": ["things"], "identified_by": ["id"]}}, "requirements": {"s": {"subject": "thing", "checks": {"c": "x is not one of \"prod\", \"staging\""}}}},
    "cases": [
      {
        "description": "passes on a string that is none of them, fails as value on one of them, and fails as unusable on another type",
        "rules": ["not_in.pass", "not_in.fail", "sentence.phrase.one_of"],
        "input": {"things": [{"id": "t1", "x": "dev"}, {"id": "t2", "x": "prod"}, {"id": "t3", "x": 5}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": true, "cause": "satisfied", "inputs": [{"name": "x", "value": "dev"}]},
          {"requirement": "s", "subject": {"type": "thing", "id": "t2"}, "check": "c", "passed": false, "cause": "value", "inputs": [{"name": "x", "value": "prod"}]},
          {"requirement": "s", "subject": {"type": "thing", "id": "t3"}, "check": "c", "passed": false, "cause": "unusable", "inputs": [{"name": "x", "value": 5}]}
        ]
      }
    ]
  },
  {
    "description": "in values read through a ref that holds an object like a ref",
    "policy": {"subjects": {"thing": {"from": ["things"], "identified_by": ["id"]}}, "requirements": {"s": {"subject": "thing", "checks": {"c": {"op": "in", "path": ["x"], "values": {"ref": ["$$params", "allowed"]}}}}}},
    "params": {"allowed": [{"ref": ["q"]}]},
    "cases": [
      {
        "description": "compares the object as it is",
        "rules": ["in.values", "path.inputs"],
        "input": {"things": [{"id": "t1", "x": {"ref": ["q"]}}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": true, "cause": "satisfied", "inputs": [{"name": "x", "value": {"ref": ["q"]}}]}
        ]
      }
    ]
  },
  {
    "description": "in values held in a literal",
    "policy": {"subjects": {"thing": {"from": ["things"], "identified_by": ["id"]}}, "requirements": {"s": {"subject": "thing", "checks": {"c": {"op": "in", "path": ["x"], "values": {"literal": [{"ref": ["q"]}]}}}}}},
    "cases": [
      {
        "description": "compares the object as it is",
        "rules": ["in.values", "value.literal", "render.path", "in.expression", "path.inputs"],
        "input": {"things": [{"id": "t1", "x": {"ref": ["q"]}}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": true, "cause": "satisfied", "inputs": [{"name": "x", "value": {"ref": ["q"]}}]}
        ],
        "expressions": {"s": {"c": "x in [{\"ref\": [\"q\"]}]"}}
      }
    ]
  },
  {
    "description": "in written wrong",
    "policy": {
      "subjects": {
        "thing": {
          "from": ["things"],
          "identified_by": ["id"]
        }
      },
      "requirements": {
        "s": {
          "subject": "thing",
          "checks": {
            "deep_ref": {"op": "in", "path": ["x"], "values": [[{"ref": ["$$params", "want"]}]]},
            "literal_not_a_list": {"op": "in", "path": ["x"], "values": {"literal": "a"}},
            "mixed_types": {"op": "in", "path": ["x"], "values": ["a", 1, {"ref": ["$$params", "want"]}]},
            "no_values": {"op": "in", "path": ["x"]},
            "not_a_list": {"op": "in", "path": ["x"], "values": "a"}
          }
        }
      }
    },
    "cases": [
      {
        "description": "fails every check as ill_formed and says why",
        "rules": ["in.values", "value.nested", "written_wrong", "written_wrong.row", "in.written_wrong", "render.path", "in.expression", "path.inputs"],
        "input": {"things": [{"id": "t1", "x": "a"}]},
        "results": [
          {
            "requirement": "s",
            "subject": {"type": "thing", "id": null},
            "check": "$well_formed",
            "passed": false,
            "cause": "value",
            "inputs": [
              {"name": "count(checks)", "value": 5},
              {"name": "require", "value": "every"},
              {"name": "checks.deep_ref", "value": ["ref inside values"]},
              {"name": "checks.literal_not_a_list", "value": ["invalid values"]},
              {"name": "checks.mixed_types", "value": ["values of mixed types"]},
              {"name": "checks.no_values", "value": ["missing values"]},
              {"name": "checks.not_a_list", "value": ["invalid values"]}
            ]
          },
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "deep_ref", "passed": false, "cause": "ill_formed", "inputs": [{"name": "x", "value": "a"}]},
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "literal_not_a_list", "passed": false, "cause": "ill_formed", "inputs": [{"name": "x", "value": "a"}]},
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "mixed_types", "passed": false, "cause": "ill_formed", "inputs": [{"name": "x", "value": "a"}]},
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "no_values", "passed": false, "cause": "ill_formed", "inputs": [{"name": "x", "value": "a"}]},
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "not_a_list", "passed": false, "cause": "ill_formed", "inputs": [{"name": "x", "value": "a"}]}
        ],
        "expressions": {"s": {"literal_not_a_list": "x in <invalid values>", "no_values": "x in <missing values>", "not_a_list": "x in <invalid values>"}}
      }
    ]
  }
]
