          {"cause": "absent", "check": "not_in", "inputs": [{"locations": ["/things/0/x"], "name": "x", "value": "click"}], "message": "$input.sbom.components.name is missing", "passed": false, "requirement": "s", "subject": {"id": "t1", "type": "thing"}}
