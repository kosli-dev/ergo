[
  {
    "description": "in a list",
    "policy": {"ergo_spec": "v0.2-dev", "subjects": {"thing": {"from": "things", "identified_by": "id"}}, "requirements": {"s": {"subject": "thing", "checks": {"c": "x is one of \"b\", \"a\""}}}},
    "cases": [
      {
        "description": "passes when the field is one of the values",
        "rules": ["in.pass", "sentence.print.canonical", "path.inputs"],
        "input": {"things": [{"id": "t1", "x": "b"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": true, "cause": "satisfied", "inputs": [{"name": "x", "value": "b"}]}
        ],
        "expressions": {"s": {"c": "x is one of \"b\", \"a\""}}
      },
      {
        "description": "fails as value when it is none of them",
        "rules": ["in.fail"],
        "input": {"things": [{"id": "t1", "x": "c"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": false, "cause": "value", "inputs": [{"name": "x", "value": "c"}]}
        ]
      },
      {
        "description": "fails as unusable when the field has another type than the values",
        "rules": ["in.fail"],
        "input": {"things": [{"id": "t1", "x": 1}, {"id": "t2", "x": true}, {"id": "t3", "x": ["b"]}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": false, "cause": "unusable", "inputs": [{"name": "x", "value": 1}]},
          {"requirement": "s", "subject": {"type": "thing", "id": "t2"}, "check": "c", "passed": false, "cause": "unusable", "inputs": [{"name": "x", "value": true}]},
          {"requirement": "s", "subject": {"type": "thing", "id": "t3"}, "check": "c", "passed": false, "cause": "unusable", "inputs": [{"name": "x", "value": ["b"]}]}
        ]
      }
    ]
  },
  {
    "description": "in a list of numbers",
    "policy": {"ergo_spec": "v0.2-dev", "subjects": {"thing": {"from": "things", "identified_by": "id"}}, "requirements": {"s": {"subject": "thing", "checks": {"c": "x is one of 1, 2"}}}},
    "cases": [
      {
        "description": "passes on 1.0, because numbers compare by value",
        "rules": ["in.pass", "value.equal"],
        "input": {"things": [{"id": "t1", "x": 1.0}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": true, "cause": "satisfied", "inputs": [{"name": "x", "value": 1}]}
        ]
      },
      {
        "description": "fails as unusable on the string \"1\"",
        "rules": ["in.fail"],
        "input": {"things": [{"id": "t1", "x": "1"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": false, "cause": "unusable", "inputs": [{"name": "x", "value": "1"}]}
        ]
      }
    ]
  },
  {
    "description": "in a list holding null",
    "policy": {"ergo_spec": "v0.2-dev", "subjects": {"thing": {"from": "things", "identified_by": "id"}}, "requirements": {"s": {"subject": "thing", "checks": {"c": "x is one of \"a\", null"}}}},
    "cases": [
      {
        "description": "fails as absent on a missing field",
        "rules": ["in.fail", "path.inputs"],
        "input": {"things": [{"id": "t1"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": false, "cause": "absent", "inputs": [{"name": "x", "value": null}]}
        ]
      },
      {
        "description": "fails as null on a null field",
        "rules": ["in.fail"],
        "input": {"things": [{"id": "t1", "x": null}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": false, "cause": "null", "inputs": [{"name": "x", "value": null}]}
        ]
      },
      {
        "description": "passes on a field that is one of the other values, since null doesn't count as a type",
        "rules": ["in.values", "in.pass"],
        "input": {"things": [{"id": "t1", "x": "a"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": true, "cause": "satisfied", "inputs": [{"name": "x", "value": "a"}]}
        ]
      }
    ]
  },
  {
    "description": "in values read through a ref",
    "policy": {"ergo_spec": "v0.2-dev", "subjects": {"thing": {"from": "things", "identified_by": "id"}}, "requirements": {"s": {"subject": "thing", "checks": {"c": "x is one of $params.allowed"}}}},
    "params": {"allowed": ["a", "b"]},
    "cases": [
      {
        "description": "passes when the field is in the list",
        "rules": ["in.values", "in.pass", "sentence.print.canonical", "path.inputs"],
        "input": {"things": [{"id": "t1", "x": "a"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": true, "cause": "satisfied", "inputs": [{"name": "x", "value": "a"}]}
        ],
        "expressions": {"s": {"c": "x is in $params.allowed"}}
      }
    ]
  },
  {
    "description": "in values read through a ref that isn't a list",
    "policy": {"ergo_spec": "v0.2-dev", "subjects": {"thing": {"from": "things", "identified_by": "id"}}, "requirements": {"s": {"subject": "thing", "checks": {"c": "x is one of $params.allowed"}}}},
    "params": {"allowed": "a"},
    "cases": [
      {
        "description": "fails as unusable",
        "rules": ["in.values", "path.inputs"],
        "input": {"things": [{"id": "t1", "x": "a"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": false, "cause": "unusable", "inputs": [{"name": "x", "value": "a"}]}
        ]
      }
    ]
  },
  {
    "description": "in values read through a ref that holds values of mixed types",
    "policy": {"ergo_spec": "v0.2-dev", "subjects": {"thing": {"from": "things", "identified_by": "id"}}, "requirements": {"s": {"subject": "thing", "checks": {"c": "x is one of $params.allowed"}}}},
    "params": {"allowed": ["a", 1]},
    "cases": [
      {
        "description": "fails as unusable, even when the field is one of them or missing",
        "rules": ["in.values", "path.inputs"],
        "input": {"things": [{"id": "t1", "x": "a"}, {"id": "t2"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": false, "cause": "unusable", "inputs": [{"name": "x", "value": "a"}]},
          {"requirement": "s", "subject": {"type": "thing", "id": "t2"}, "check": "c", "passed": false, "cause": "unusable", "inputs": [{"name": "x", "value": null}]}
        ]
      }
    ]
  },
  {
    "description": "is not one of a list",
    "policy": {"ergo_spec": "v0.2-dev", "subjects": {"thing": {"from": "things", "identified_by": "id"}}, "requirements": {"s": {"subject": "thing", "checks": {"c": "x is not one of \"prod\", \"staging\""}}}},
    "cases": [
      {
        "description": "passes on a string that is none of them, fails as value on one of them, and fails as unusable on another type",
        "rules": ["not_in.pass", "not_in.fail", "sentence.phrase.one_of"],
        "input": {"things": [{"id": "t1", "x": "dev"}, {"id": "t2", "x": "prod"}, {"id": "t3", "x": 5}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": true, "cause": "satisfied", "inputs": [{"name": "x", "value": "dev"}]},
          {"requirement": "s", "subject": {"type": "thing", "id": "t2"}, "check": "c", "passed": false, "cause": "value", "inputs": [{"name": "x", "value": "prod"}]},
          {"requirement": "s", "subject": {"type": "thing", "id": "t3"}, "check": "c", "passed": false, "cause": "unusable", "inputs": [{"name": "x", "value": 5}]}
        ]
      }
    ]
  },
  {
    "description": "in values read through a ref that holds an object like a ref",
    "policy": {"ergo_spec": "v0.2-dev", "subjects": {"thing": {"from": "things", "identified_by": "id"}}, "requirements": {"s": {"subject": "thing", "checks": {"c": "x is one of $params.allowed"}}}},
    "params": {"allowed": [{"ref": ["q"]}]},
    "cases": [
      {
        "description": "compares the object as it is",
        "rules": ["in.values", "path.inputs"],
        "input": {"things": [{"id": "t1", "x": {"ref": ["q"]}}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": true, "cause": "satisfied", "inputs": [{"name": "x", "value": {"ref": ["q"]}}]}
        ]
      }
    ]
  }
]
