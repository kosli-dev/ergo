[
  {
    "description": "in a list",
    "policy": {"ergo_spec": "v0.5-dev", "subjects": {"thing": {"from": "things", "identified_by": "id"}}, "requirements": {"s": {"subject": "thing", "checks": {"c": "x is one of \"b\", \"a\""}}}},
    "cases": [
      {
        "description": "passes when the field is one of the values",
        "rules": ["in.pass", "sentence.print.canonical", "path.inputs"],
        "input": {"things": [{"id": "t1", "x": "b"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": true, "cause": "satisfied", "inputs": [{"name": "x", "value": "b", "locations": ["/things/0/x"]}]}
        ],
        "expressions": {"s": {"c": "x is one of \"b\", \"a\""}}
      },
      {
        "description": "fails as value when it is none of them",
        "rules": ["in.fail"],
        "input": {"things": [{"id": "t1", "x": "c"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "message": "x is \"c\"", "passed": false, "cause": "value", "inputs": [{"name": "x", "value": "c", "locations": ["/things/0/x"]}]}
        ]
      },
      {
        "description": "fails as unusable when the field has another type than the values",
        "rules": ["in.fail"],
        "input": {"things": [{"id": "t1", "x": 1}, {"id": "t2", "x": true}, {"id": "t3", "x": ["b"]}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "message": "x is 1, which isn't text", "passed": false, "cause": "unusable", "inputs": [{"name": "x", "value": 1, "locations": ["/things/0/x"]}]},
          {"requirement": "s", "subject": {"type": "thing", "id": "t2"}, "check": "c", "message": "x is true, which isn't text", "passed": false, "cause": "unusable", "inputs": [{"name": "x", "value": true, "locations": ["/things/1/x"]}]},
          {"requirement": "s", "subject": {"type": "thing", "id": "t3"}, "check": "c", "message": "x is [\"b\"], which isn't text", "passed": false, "cause": "unusable", "inputs": [{"name": "x", "value": ["b"], "locations": ["/things/2/x"]}]}
        ]
      }
    ]
  },
  {
    "description": "in a list of numbers",
    "policy": {"ergo_spec": "v0.5-dev", "subjects": {"thing": {"from": "things", "identified_by": "id"}}, "requirements": {"s": {"subject": "thing", "checks": {"c": "x is one of 1, 2"}}}},
    "cases": [
      {
        "description": "passes on 1.0, because numbers compare by value",
        "rules": ["in.pass", "value.equal"],
        "input": {"things": [{"id": "t1", "x": 1.0}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": true, "cause": "satisfied", "inputs": [{"name": "x", "value": 1, "locations": ["/things/0/x"]}]}
        ]
      },
      {
        "description": "fails as unusable on the string \"1\"",
        "rules": ["in.fail"],
        "input": {"things": [{"id": "t1", "x": "1"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "message": "x is \"1\", which isn't a number", "passed": false, "cause": "unusable", "inputs": [{"name": "x", "value": "1", "locations": ["/things/0/x"]}]}
        ]
      }
    ]
  },
  {
    "description": "in a list holding null",
    "policy": {"ergo_spec": "v0.5-dev", "subjects": {"thing": {"from": "things", "identified_by": "id"}}, "requirements": {"s": {"subject": "thing", "checks": {"c": "x is one of \"a\", null"}}}},
    "cases": [
      {
        "description": "fails as absent on a missing field",
        "rules": ["in.fail", "path.inputs"],
        "input": {"things": [{"id": "t1"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "message": "x is missing", "passed": false, "cause": "absent", "inputs": [{"name": "x", "value": null, "locations": ["/things/0"]}]}
        ]
      },
      {
        "description": "fails as null on a null field",
        "rules": ["in.fail"],
        "input": {"things": [{"id": "t1", "x": null}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "message": "x is null", "passed": false, "cause": "null", "inputs": [{"name": "x", "value": null, "locations": ["/things/0/x"]}]}
        ]
      },
      {
        "description": "passes on a field that is one of the other values, since null doesn't count as a type",
        "rules": ["in.values", "in.pass"],
        "input": {"things": [{"id": "t1", "x": "a"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": true, "cause": "satisfied", "inputs": [{"name": "x", "value": "a", "locations": ["/things/0/x"]}]}
        ]
      }
    ]
  },
  {
    "description": "in values read through a ref",
    "policy": {"ergo_spec": "v0.5-dev", "subjects": {"thing": {"from": "things", "identified_by": "id"}}, "requirements": {"s": {"subject": "thing", "checks": {"c": "x is one of $params.allowed"}}}},
    "params": {"allowed": ["a", "b"]},
    "cases": [
      {
        "description": "passes when the field is in the list",
        "rules": ["in.values", "in.pass", "sentence.print.canonical", "path.inputs"],
        "input": {"things": [{"id": "t1", "x": "a"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": true, "cause": "satisfied", "inputs": [{"name": "x", "value": "a", "locations": ["/things/0/x"]}]}
        ],
        "expressions": {"s": {"c": "x is in $params.allowed"}}
      }
    ]
  },
  {
    "description": "in values read through a ref that isn't a list",
    "policy": {"ergo_spec": "v0.5-dev", "subjects": {"thing": {"from": "things", "identified_by": "id"}}, "requirements": {"s": {"subject": "thing", "checks": {"c": "x is one of $params.allowed"}}}},
    "params": {"allowed": "a"},
    "cases": [
      {
        "description": "fails as unusable",
        "rules": ["in.values", "path.inputs"],
        "input": {"things": [{"id": "t1", "x": "a"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "message": "$params.allowed is \"a\", which isn't a list", "passed": false, "cause": "unusable", "inputs": [{"name": "x", "value": "a", "locations": ["/things/0/x"]}]}
        ]
      }
    ]
  },
  {
    "description": "in values read through a ref that holds values of mixed types",
    "policy": {"ergo_spec": "v0.5-dev", "subjects": {"thing": {"from": "things", "identified_by": "id"}}, "requirements": {"s": {"subject": "thing", "checks": {"c": "x is one of $params.allowed"}}}},
    "params": {"allowed": ["a", 1]},
    "cases": [
      {
        "description": "fails as unusable, even when the field is one of them or missing",
        "rules": ["in.values", "path.inputs"],
        "input": {"things": [{"id": "t1", "x": "a"}, {"id": "t2"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "message": "x is \"a\", which isn't a number or text, and $params.allowed is [\"a\", 1], which isn't a list of one kind of value", "passed": false, "cause": "unusable", "inputs": [{"name": "x", "value": "a", "locations": ["/things/0/x"]}]},
          {"requirement": "s", "subject": {"type": "thing", "id": "t2"}, "check": "c", "message": "$params.allowed is [\"a\", 1], which isn't a list of one kind of value", "passed": false, "cause": "unusable", "inputs": [{"name": "x", "value": null, "locations": ["/things/1"]}]}
        ]
      }
    ]
  },
  {
    "description": "is not one of a list",
    "policy": {"ergo_spec": "v0.5-dev", "subjects": {"thing": {"from": "things", "identified_by": "id"}}, "requirements": {"s": {"subject": "thing", "checks": {"c": "x is not one of \"prod\", \"staging\""}}}},
    "cases": [
      {
        "description": "passes on a string that is none of them, fails as value on one of them, and fails as unusable on another type",
        "rules": ["not_in.pass", "not_in.fail", "sentence.phrase.one_of"],
        "input": {"things": [{"id": "t1", "x": "dev"}, {"id": "t2", "x": "prod"}, {"id": "t3", "x": 5}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": true, "cause": "satisfied", "inputs": [{"name": "x", "value": "dev", "locations": ["/things/0/x"]}]},
          {"requirement": "s", "subject": {"type": "thing", "id": "t2"}, "check": "c", "message": "x is \"prod\"", "passed": false, "cause": "value", "inputs": [{"name": "x", "value": "prod", "locations": ["/things/1/x"]}]},
          {"requirement": "s", "subject": {"type": "thing", "id": "t3"}, "check": "c", "message": "x is 5, which isn't text", "passed": false, "cause": "unusable", "inputs": [{"name": "x", "value": 5, "locations": ["/things/2/x"]}]}
        ]
      }
    ]
  },
  {
    "description": "in values read through a ref that holds an object like a ref",
    "policy": {"ergo_spec": "v0.5-dev", "subjects": {"thing": {"from": "things", "identified_by": "id"}}, "requirements": {"s": {"subject": "thing", "checks": {"c": "x is one of $params.allowed"}}}},
    "params": {"allowed": [{"ref": ["q"]}]},
    "cases": [
      {
        "description": "compares the object as it is",
        "rules": ["in.values", "path.inputs"],
        "input": {"things": [{"id": "t1", "x": {"ref": ["q"]}}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": true, "cause": "satisfied", "inputs": [{"name": "x", "value": {"ref": ["q"]}, "locations": ["/things/0/x"]}]}
        ]
      }
    ]
  },
  {
    "description": "a list read through a ref",
    "policy": {"ergo_spec": "v0.5-dev", "subjects": {"thing": {"from": "things", "identified_by": "id"}}, "requirements": {"s": {"subject": "thing", "checks": {"c": "x is in $params.allowed"}}}},
    "params": {"allowed": ["p", "q"]},
    "cases": [
      {
        "description": "gives the ref's location in $refs, and in the violation's inputs",
        "rules": ["location.refs"],
        "input": {"things": [{"id": "t1", "x": "z"}]},
        "results": [
          {"cause": "value", "check": "c", "inputs": [{"locations": ["/things/0/x"], "name": "x", "value": "z"}], "message": "x is \"z\", and $params.allowed is [\"p\", \"q\"]", "passed": false, "requirement": "s", "subject": {"id": "t1", "type": "thing"}}
        ],
        "refs": {"s": {"c": [{"locations": ["$params:/allowed"], "name": "$params.allowed", "value": ["p", "q"]}]}},
        "violations": [
          {"cause": "value", "check": "c", "description": "", "expression": "x is in $params.allowed", "inputs": [{"locations": ["/things/0/x"], "name": "x", "value": "z"}, {"locations": ["$params:/allowed"], "name": "$params.allowed", "value": ["p", "q"]}], "message": "x is \"z\", and $params.allowed is [\"p\", \"q\"]", "requirement": "s", "subject": {"id": "t1", "type": "thing"}}
        ]
      }
    ]
  },
  {
    "description": "a ref on the right side that walks a list of objects",
    "policy": {"ergo_spec": "v0.5-dev", "subjects": {"thing": {"from": "things", "identified_by": "id"}}, "requirements": {"s": {"subject": "thing", "checks": {"in": "x is in $input.sbom.components.name", "not_in": "x is not in $input.sbom.components.name"}}}},
    "cases": [
      {
        "description": "compares with the list of what it reads from each item, and lists it in $refs and in the violation's inputs",
        "rules": ["walk.right", "compare.list", "sentence.phrase.one_of", "walk.right.inputs", "location.refs"],
        "input": {"sbom": {"components": [{"name": "click"}, {"name": "jinja2"}]}, "things": [{"id": "t1", "x": "click"}, {"id": "t2", "x": "attrs"}]},
        "results": [
          {"cause": "satisfied", "check": "in", "inputs": [{"locations": ["/things/0/x"], "name": "x", "value": "click"}], "passed": true, "requirement": "s", "subject": {"id": "t1", "type": "thing"}},
          {"cause": "value", "check": "not_in", "inputs": [{"locations": ["/things/0/x"], "name": "x", "value": "click"}], "message": "x is \"click\", and $input.sbom.components[].name is [\"click\", \"jinja2\"]", "passed": false, "requirement": "s", "subject": {"id": "t1", "type": "thing"}},
          {"cause": "value", "check": "in", "inputs": [{"locations": ["/things/1/x"], "name": "x", "value": "attrs"}], "message": "x is \"attrs\", and $input.sbom.components[].name is [\"click\", \"jinja2\"]", "passed": false, "requirement": "s", "subject": {"id": "t2", "type": "thing"}},
          {"cause": "satisfied", "check": "not_in", "inputs": [{"locations": ["/things/1/x"], "name": "x", "value": "attrs"}], "passed": true, "requirement": "s", "subject": {"id": "t2", "type": "thing"}}
        ],
        "refs": {"s": {"in": [{"locations": ["/sbom/components/0/name", "/sbom/components/1/name"], "name": "$input.sbom.components[].name", "value": ["click", "jinja2"]}], "not_in": [{"locations": ["/sbom/components/0/name", "/sbom/components/1/name"], "name": "$input.sbom.components[].name", "value": ["click", "jinja2"]}]}},
        "violations": [{"cause": "value", "check": "not_in", "description": "", "expression": "x is not in $input.sbom.components.name", "inputs": [{"locations": ["/things/0/x"], "name": "x", "value": "click"}, {"locations": ["/sbom/components/0/name", "/sbom/components/1/name"], "name": "$input.sbom.components[].name", "value": ["click", "jinja2"]}], "message": "x is \"click\", and $input.sbom.components[].name is [\"click\", \"jinja2\"]", "requirement": "s", "subject": {"id": "t1", "type": "thing"}}, {"cause": "value", "check": "in", "description": "", "expression": "x is in $input.sbom.components.name", "inputs": [{"locations": ["/things/1/x"], "name": "x", "value": "attrs"}, {"locations": ["/sbom/components/0/name", "/sbom/components/1/name"], "name": "$input.sbom.components[].name", "value": ["click", "jinja2"]}], "message": "x is \"attrs\", and $input.sbom.components[].name is [\"click\", \"jinja2\"]", "requirement": "s", "subject": {"id": "t2", "type": "thing"}}]
      },
      {
        "description": "fails every row as absent when an item has no name, because it cannot tell",
        "rules": ["walk.right", "compare.list", "sentence.phrase.one_of", "walk.right.fail"],
        "input": {"sbom": {"components": [{"name": "click"}, {}]}, "things": [{"id": "t1", "x": "click"}, {"id": "t2", "x": "attrs"}]},
        "results": [
          {"cause": "absent", "check": "in", "inputs": [{"locations": ["/things/0/x"], "name": "x", "value": "click"}], "message": "item 2 of $input.sbom.components: name is missing", "passed": false, "requirement": "s", "subject": {"id": "t1", "type": "thing"}},
          {"cause": "absent", "check": "not_in", "inputs": [{"locations": ["/things/0/x"], "name": "x", "value": "click"}], "message": "item 2 of $input.sbom.components: name is missing", "passed": false, "requirement": "s", "subject": {"id": "t1", "type": "thing"}},
          {"cause": "absent", "check": "in", "inputs": [{"locations": ["/things/1/x"], "name": "x", "value": "attrs"}], "message": "item 2 of $input.sbom.components: name is missing", "passed": false, "requirement": "s", "subject": {"id": "t2", "type": "thing"}},
          {"cause": "absent", "check": "not_in", "inputs": [{"locations": ["/things/1/x"], "name": "x", "value": "attrs"}], "message": "item 2 of $input.sbom.components: name is missing", "passed": false, "requirement": "s", "subject": {"id": "t2", "type": "thing"}}
        ]
      },
      {
        "description": "fails every row as null when an item has a null name",
        "rules": ["walk.right", "compare.list", "sentence.phrase.one_of", "walk.right.fail"],
        "input": {"sbom": {"components": [{"name": "click"}, {"name": null}]}, "things": [{"id": "t1", "x": "click"}]},
        "results": [
          {"cause": "null", "check": "in", "inputs": [{"locations": ["/things/0/x"], "name": "x", "value": "click"}], "message": "item 2 of $input.sbom.components: name is null", "passed": false, "requirement": "s", "subject": {"id": "t1", "type": "thing"}},
          {"cause": "null", "check": "not_in", "inputs": [{"locations": ["/things/0/x"], "name": "x", "value": "click"}], "message": "item 2 of $input.sbom.components: name is null", "passed": false, "requirement": "s", "subject": {"id": "t1", "type": "thing"}}
        ]
      },
      {
        "description": "fails as value, after is not in too, when the list is empty",
        "rules": ["walk.right", "compare.list", "sentence.phrase.one_of", "walk.right.fail"],
        "input": {"sbom": {"components": []}, "things": [{"id": "t1", "x": "click"}]},
        "results": [
          {"cause": "value", "check": "in", "inputs": [{"locations": ["/things/0/x"], "name": "x", "value": "click"}], "message": "x is \"click\", and $input.sbom.components is []", "passed": false, "requirement": "s", "subject": {"id": "t1", "type": "thing"}},
          {"cause": "value", "check": "not_in", "inputs": [{"locations": ["/things/0/x"], "name": "x", "value": "click"}], "message": "x is \"click\", and $input.sbom.components is []", "passed": false, "requirement": "s", "subject": {"id": "t1", "type": "thing"}}
        ]
      },
      {
        "description": "fails as unusable and says which item is not an object",
        "rules": ["walk.right", "compare.list", "sentence.phrase.one_of", "walk.right.fail"],
        "input": {"sbom": {"components": ["click"]}, "things": [{"id": "t1", "x": "click"}]},
        "results": [
          {"cause": "unusable", "check": "in", "inputs": [{"locations": ["/things/0/x"], "name": "x", "value": "click"}], "message": "item 1 of $input.sbom.components is \"click\", which isn't an object", "passed": false, "requirement": "s", "subject": {"id": "t1", "type": "thing"}},
          {"cause": "unusable", "check": "not_in", "inputs": [{"locations": ["/things/0/x"], "name": "x", "value": "click"}], "message": "item 1 of $input.sbom.components is \"click\", which isn't an object", "passed": false, "requirement": "s", "subject": {"id": "t1", "type": "thing"}}
        ]
      },
      {
        "description": "fails as unusable when the names are of more than one type",
        "rules": ["walk.right", "compare.list", "sentence.phrase.one_of", "walk.right.fail", "compare.list"],
        "input": {"sbom": {"components": [{"name": "click"}, {"name": 3}]}, "things": [{"id": "t1", "x": "click"}]},
        "results": [
          {"cause": "unusable", "check": "in", "inputs": [{"locations": ["/things/0/x"], "name": "x", "value": "click"}], "message": "x is \"click\", which isn't a number or text, and $input.sbom.components[].name is [\"click\", 3], which isn't a list of one kind of value", "passed": false, "requirement": "s", "subject": {"id": "t1", "type": "thing"}},
          {"cause": "unusable", "check": "not_in", "inputs": [{"locations": ["/things/0/x"], "name": "x", "value": "click"}], "message": "x is \"click\", which isn't a number or text, and $input.sbom.components[].name is [\"click\", 3], which isn't a list of one kind of value", "passed": false, "requirement": "s", "subject": {"id": "t1", "type": "thing"}}
        ]
      },
      {
        "description": "reads the path as it always did when no step meets a list, and fails as absent",
        "rules": ["walk.right", "compare.list", "sentence.phrase.one_of", "walk.right.plain"],
        "input": {"sbom": {"components": {"name": ["click"]}}, "things": [{"id": "t1", "x": "click"}]},
        "results": [
          {"cause": "satisfied", "check": "in", "inputs": [{"locations": ["/things/0/x"], "name": "x", "value": "click"}], "passed": true, "requirement": "s", "subject": {"id": "t1", "type": "thing"}},
          {"cause": "value", "check": "not_in", "inputs": [{"locations": ["/things/0/x"], "name": "x", "value": "click"}], "message": "x is \"click\", and $input.sbom.components.name is [\"click\"]", "passed": false, "requirement": "s", "subject": {"id": "t1", "type": "thing"}}
