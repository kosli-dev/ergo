          {"requirement": "s", "subject": {"type": "thing", "id": "t2"}, "check": "c", "passed": true, "cause": "satisfied", "inputs": [{"name": "x", "value": [1, null], "locations": ["/things/1/x"]}]}
        ]
      },
      {
        "description": "fails as unusable on the string \"1\"",
        "rules": ["contains.fail", "value.equal"],
        "input": {"things": [{"id": "t1", "x": ["1"]}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "message": "x is [\"1\"], which isn't a list of numbers", "passed": false, "cause": "unusable", "inputs": [{"name": "x", "value": ["1"], "locations": ["/things/0/x"]}]}
        ]
      }
    ]
  },
