          {"cause": "unusable", "check": "no_name", "inputs": [{"locations": ["/things/0/labels"], "name": "labels", "value": [["a"]]}, {"locations": ["/things/0/x"], "name": "x.name", "value": null}], "message": "x is [{\"name\": \"a\"}], which isn't an object", "passed": false, "requirement": "s", "subject": {"id": "t1", "type": "thing"}}
        ]
      },
