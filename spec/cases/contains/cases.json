[
  {
    "description": "includes a value",
    "policy": {"ergo_spec": "v0.6-dev", "subjects": {"thing": {"from": "things", "identified_by": "id"}}, "requirements": {"s": {"subject": "thing", "checks": {"c": "x contains \"a\""}}}},
    "cases": [
      {
        "description": "passes when the list contains it",
        "rules": ["contains.pass", "sentence.print.canonical"],
        "input": {"things": [{"id": "t1", "x": ["b", "a"]}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "passed": true, "cause": "satisfied", "inputs": [{"name": "x", "value": ["b", "a"], "locations": ["/things/0/x"]}]}
        ],
        "expressions": {"s": {"c": "x contains \"a\""}}
      },
      {
        "description": "fails as value when it doesn't",
        "rules": ["contains.fail"],
        "input": {"things": [{"id": "t1", "x": ["b"]}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "message": "x is [\"b\"]", "passed": false, "cause": "value", "inputs": [{"name": "x", "value": ["b"], "locations": ["/things/0/x"]}]}
        ]
      },
      {
        "description": "fails as value on an empty list",
        "rules": ["contains.pass", "contains.fail"],
        "input": {"things": [{"id": "t1", "x": []}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "message": "x is []", "passed": false, "cause": "value", "inputs": [{"name": "x", "value": [], "locations": ["/things/0/x"]}]}
        ]
      },
      {
        "description": "fails as unusable on a string that holds it",
        "rules": ["contains.fail"],
        "input": {"things": [{"id": "t1", "x": "abc"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "message": "x is \"abc\", which isn't a list", "passed": false, "cause": "unusable", "inputs": [{"name": "x", "value": "abc", "locations": ["/things/0/x"]}]}
        ]
      },
      {
        "description": "fails as unusable on an object that holds it",
        "rules": ["contains.fail"],
        "input": {"things": [{"id": "t1", "x": {"a": "a"}}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "message": "x is {\"a\": \"a\"}, which isn't a list", "passed": false, "cause": "unusable", "inputs": [{"name": "x", "value": {"a": "a"}, "locations": ["/things/0/x"]}]}
        ]
      },
      {
        "description": "fails as absent when the field is missing",
        "rules": ["contains.fail", "path.absent"],
        "input": {"things": [{"id": "t1"}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "message": "x is missing", "passed": false, "cause": "absent", "inputs": [{"name": "x", "value": null, "locations": ["/things/0"]}]}
        ]
      },
      {
        "description": "fails as null when the field is null",
        "rules": ["contains.fail", "path.null"],
        "input": {"things": [{"id": "t1", "x": null}]},
        "results": [
          {"requirement": "s", "subject": {"type": "thing", "id": "t1"}, "check": "c", "message": "x is null", "passed": false, "cause": "null", "inputs": [{"name": "x", "value": null, "locations": ["/things/0/x"]}]}
        ]
      }
    ]
  },
  {
